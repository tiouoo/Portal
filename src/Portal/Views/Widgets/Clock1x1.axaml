<UserControl
    d:DesignHeight="130"
    d:DesignWidth="130"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.Clock1x1"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource ClockGeometry}" Width="17" />
                <TextBlock Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.widgets_clock_currentTime}}" />
            </StackPanel>
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Margin="0,2,0,0"
                Name="TimeText"
                Text="--:--" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="0,-2,0,0"
                Name="DateText"
                Text="--:--" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="0,-6,0,0"
                Name="WeekText"
                Text="--:--" />
        </StackPanel>
    </Grid>
</UserControl>