<UserControl
    Margin="-4,-4,-4,-4"
    d:DesignHeight="130"
    d:DesignWidth="130"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.QuickServerWidget1x1"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="Transparent"
        CornerRadius="10"
        Cursor="Hand"
        Name="Card">
        <Border.Styles>
            <Style Selector="Border#Card">
                <Style Selector="^ Button#LaunchButton">
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </Style>
            <Style Selector="Border#Card:pointerover">
                <Style Selector="^ Button#LaunchButton">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </Style>
        </Border.Styles>
        <DockPanel LastChildFill="False" Margin="8,5,8,6">
            <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse
                        Height="5"
                        Name="StatusDot"
                        VerticalAlignment="Center"
                        Width="5" />
                    <TextBlock
                        FontSize="11"
                        MaxLines="1"
                        Name="StatusText"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontSize="11"
                        IsVisible="False"
                        MaxLines="1"
                        Name="PingText"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    IsVisible="False"
                    Margin="0,0,0,-4"
                    MaxLines="1"
                    Name="PlayersText"
                    TextTrimming="CharacterEllipsis" />
                <DockPanel>
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="LaunchButton_OnClick"
                        Cursor="Hand"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        MinHeight="18"
                        Padding="2,-4,0,-4"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="快速进入服务器"
                        VerticalAlignment="Center"
                        x:Name="LaunchButton">
                        <PathIcon
                            Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                            Foreground="{DynamicResource InnerForegroundColor}"
                            Height="12"
                            Width="12" />
                        <Button.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Duration="0:0:0.15"
                                    Easing="SineEaseOut"
                                    Property="Opacity" />
                            </Transitions>
                        </Button.Transitions>
                    </Button>
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        MaxLines="1"
                        Name="AddressText"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
            <Border
                ClipToBounds="True"
                CornerRadius="8"
                DockPanel.Dock="Top"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,1,0,3"
                VerticalAlignment="Top"
                Width="40">
                <Image
                    Height="40"
                    Name="IconImage"
                    Width="40" />
            </Border>
        </DockPanel>
    </Border>
</UserControl>