<UserControl
    d:DesignHeight="130"
    d:DesignWidth="130"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.ResourceWidgetView1x1"
    x:DataType="local:ResourceWidgetBase"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Widgets"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10,10,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="5">
            <PathIcon
                Data="{Binding IconGeometry}"
                Height="16"
                VerticalAlignment="Center"
                Width="16" />
            <TextBlock Text="{Binding Title}" />
        </StackPanel>

        <TextBlock
            FontSize="26"
            FontWeight="SemiBold"
            Grid.Row="1"
            Margin="0,2,0,0"
            Text="{Binding PrimaryText}"
            VerticalAlignment="Center" />

        <TextBlock
            FontSize="11"
            Foreground="{DynamicResource InnerForegroundColor}"
            Grid.Row="2"
            IsVisible="{Binding HasSecondaryText}"
            Margin="0,-2,0,0"
            MaxLines="2"
            Text="{Binding SecondaryText}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>