<UserControl
    Height="560"
    MinHeight="420"
    MinWidth="640"
    Width="780"
    d:DesignHeight="560"
    d:DesignWidth="780"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.WorldPickerDialog"
    x:DataType="widgets:WorldPickerDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:widgets="clr-namespace:Portal.Views.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="14">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_title}}" />
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="{Binding InstanceHint}" />
            <TextBox
                PlaceholderText="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_searchPlaceholder}}"
                Text="{Binding SearchText}"
                Width="300">
                <TextBox.InnerRightContent>
                    <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe615;" FontSize="18" Foreground="{DynamicResource InnerForegroundColor}" />
                </TextBox.InnerRightContent>
            </TextBox>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <ItemsRepeater ItemsSource="{Binding FilteredItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemHeight="92"
                            MinItemWidth="240"
                            MinRowSpacing="12"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="widgets:WorldPickItem">
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Cursor="Hand"
                                Padding="12"
                                PointerPressed="WorldItem_OnPointerPressed"
                                Tag="{Binding}">
                                <DockPanel>
                                    <Border
                                        ClipToBounds="True"
                                        CornerRadius="8"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Width="40">
                                        <Image
                                            Height="40"
                                            Source="{Binding Icon}"
                                            Width="40" />
                                    </Border>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding Summary}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding LastPlayedText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="0,40"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="30"
                        FontWeight="Thin"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        HorizontalAlignment="Center"
                        Text="&#xe628;" />
                    <TextBlock
                        Foreground="{DynamicResource InnerForegroundColor}"
                        HorizontalAlignment="Center"
                        Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_emptyText}}" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_cancel}}" />
        </StackPanel>
    </Grid>
</UserControl>
