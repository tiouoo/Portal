<UserControl
    Height="560"
    MinHeight="420"
    MinWidth="640"
    Width="780"
    d:DesignHeight="560"
    d:DesignWidth="780"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.WorldPickerDialog"
    x:DataType="widgets:WorldPickerDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:widgets="clr-namespace:Portal.Views.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="14">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_0}}" />
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="{Binding InstanceHint}" />
            <TextBox
                PlaceholderText="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_1}}"
                Text="{Binding SearchText}"
                Width="300">
                <TextBox.InnerRightContent>
                    <PathIcon
                        Data="F1 M512,512z M0,0z M416,208C416,253.9,401.1,296.3,376,330.7L502.6,457.4C515.1,469.9 515.1,490.2 502.6,502.7 490.1,515.2 469.8,515.2 457.3,502.7L330.7,376C296.3,401.1 253.9,416 208,416 93.1,416 0,322.9 0,208 0,93.1 93.1,0 208,0 322.9,0 416,93.1 416,208z M208,352A144,144,0,1,0,208,64A144,144,0,1,0,208,352z"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Height="14"
                        Width="14" />
                </TextBox.InnerRightContent>
            </TextBox>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <ItemsRepeater ItemsSource="{Binding FilteredItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemHeight="92"
                            MinItemWidth="240"
                            MinRowSpacing="12"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="widgets:WorldPickItem">
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Cursor="Hand"
                                Padding="12"
                                PointerPressed="WorldItem_OnPointerPressed"
                                Tag="{Binding}">
                                <DockPanel>
                                    <Border
                                        ClipToBounds="True"
                                        CornerRadius="8"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Width="40">
                                        <Image
                                            Height="40"
                                            Source="{Binding Icon}"
                                            Width="40" />
                                    </Border>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding Summary}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding LastPlayedText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="0,40"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <PathIcon
                        Data="F1 M640,640z M0,0z M480,96C515.3,96,544,124.7,544,160L544,480C544,515.3,515.3,544,480,544L160,544C124.7,544,96,515.3,96,480L96,160C96,124.7,124.7,96,160,96L480,96z M368,360C368,373.3 378.7,384 392,384 405.3,384 416,373.3 416,360L416,248C416,234.7,405.3,224,392,224L280,224C266.7,224,256,234.7,256,248 256,261.3 266.7,272 280,272L334.1,272 231.1,375C221.7,384.4 221.7,399.6 231.1,408.9 240.5,418.2 255.7,418.3 265,408.9L368,305.9 368,360z"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Width="30" />
                    <TextBlock
                        Foreground="{DynamicResource InnerForegroundColor}"
                        HorizontalAlignment="Center"
                        Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_2}}" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:WidgetsLanguageManager+Keys.worldpickerdialog_3}}" />
        </StackPanel>
    </Grid>
</UserControl>