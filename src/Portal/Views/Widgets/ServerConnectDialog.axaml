<UserControl
    Height="280"
    MinHeight="260"
    MinWidth="440"
    Width="480"
    d:DesignHeight="280"
    d:DesignWidth="480"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.ServerConnectDialog"
    x:DataType="widgets:ServerConnectDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:widgets="clr-namespace:Portal.Views.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_0}}" />
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="{Binding InstanceHint}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
            <Label
                Content="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_1}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox PlaceholderText="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_2}}" Text="{Binding Address}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="6">
            <Label
                Content="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_3}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox PlaceholderText="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_4}}" Text="{Binding PortText}" />
        </StackPanel>
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource InnerForegroundColor}"
            Grid.Row="3"
            Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_5}}"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_6}}" />
            <Button Command="{Binding ConfirmCommand}" Content="{Translate {x:Static loc:WidgetsLanguageManager+Keys.serverconnectdialog_7}}" />
        </StackPanel>
    </Grid>
</UserControl>