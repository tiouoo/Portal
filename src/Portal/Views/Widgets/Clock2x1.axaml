<UserControl
    d:DesignHeight="272"
    d:DesignWidth="272"
    mc:Ignorable="d"
    x:Class="Portal.Views.Widgets.Clock2x1"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:Portal.Module">
    <Grid Margin="6">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph clock}" FontSize="17" />
                <TextBlock Text="{Translate {x:Static loc:WidgetsLanguageManager+Keys.widgets_clock_currentTime}}" />
            </StackPanel>
            <TextBlock
                FontSize="46"
                FontWeight="SemiBold"
                Margin="0,-2,0,0"
                Name="TimeWithSecondsText"
                Text="--:--" />
            <StackPanel
                Margin="0,-4,0,0"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Name="DateText"
                    Text="--:--" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Name="WeekText"
                    Text="--:--" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>