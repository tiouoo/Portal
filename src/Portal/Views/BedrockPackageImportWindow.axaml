<tio:TioWindow
    CanResize="False"
    Height="380"
    IsCloseBtnShow="{OnPlatform Default=True,
                                macOS=False}"
    IsMaxBtnShow="False"
    IsMinBtnShow="{OnPlatform Default=True,
                              macOS=False}"
    Title="{Binding WindowTitle}"
    Width="620"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="420"
    d:DesignWidth="620"
    mc:Ignorable="d"
    x:Class="Portal.Views.BedrockPackageImportWindow"
    x:DataType="views:BedrockPackageImportWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:views="clr-namespace:Portal.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <tio:TioWindow.Resources>
        <SolidColorBrush Color="Transparent" x:Key="TitleBarBackgroundColor" />
    </tio:TioWindow.Resources>
    <tio:TioWindow.TitleBarLeftContent>
        <TextBlock
            FontSize="16"
            Margin="{OnPlatform '12,2,0,0',
                                macOS='78,2,0,0'}"
            Text="{Binding WindowTitle}"
            VerticalAlignment="Center" />
    </tio:TioWindow.TitleBarLeftContent>
    <Grid Margin="26,12,26,20" RowDefinitions="Auto,*,Auto">
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Grid.Row="0"
            Padding="12">
            <StackPanel>
                <DockPanel>
                    <Border
                        Background="{DynamicResource TranslucentBorderBrush}"
                        ClipToBounds="True"
                        CornerRadius="10"
                        DockPanel.Dock="Left"
                        Height="56"
                        Margin="2,0,12,0"
                        VerticalAlignment="Top"
                        Width="56">
                        <Grid>
                            <Image
                                IsVisible="{Binding HasPackageIcon}"
                                Source="{Binding PackageIcon}"
                                Stretch="UniformToFill" />
                            <PathIcon
                                Data="F1 M640,640z M0,0z M560.3,301.2C570.7,313 588.6,315.6 602.1,306.7 616.8,296.9 620.8,277 611,262.3L563,190.3C560.2,186.1,556.4,182.6,551.9,180.1L351.4,68.7C332.1,58,308.6,58,289.2,68.7L88.8,180C83.4,183,79.1,187.4,76.2,192.8L40.2,250C23.4,280.4,34.7,319.1,65,337.7L88.5,352 112.2,366.4C120.7,371.7,131.1,370.8,138.6,364.2 190.9,319.7 269.8,272 320,272 370.2,272 449.1,319.7 501.4,364.2 508.9,370.8 519.3,371.7 527.8,366.4L551.5,352 575,337.7C605.3,319.1 608.5,280.4 591.8,250L555.8,192.8 560.3,301.2z M192,352C206.3,352 218.2,363.9 218.2,378.2 218.2,392.4 206.3,404.4 192,404.4 170.2,404.4 162,378.2 192,352z M448,352C462.2,352 474.2,363.9 474.2,378.2 474.2,392.4 462.2,404.4 448,404.4 426.2,404.4 418,378.2 448,352z"
                                Height="30"
                                IsVisible="{Binding !HasPackageIcon}"
                                Width="30" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,1,0,0" Spacing="2">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding PackageName}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource InnerForegroundColor}"
                            Text="{Binding PackageAuthorsText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource InnerForegroundColor}"
                            Text="{Binding PackageVersionText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <TextBlock
                    FontSize="13"
                    Margin="2,7,0,-3"
                    MaxLines="1"
                    Text="{Binding PackageDescription}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,0"
            Spacing="14">
            <StackPanel Spacing="6">
                <DockPanel LastChildFill="False">
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="{Translate {x:Static loc:AppLanguageManager+Keys.bedrockpackageimportwindow_importLocation}}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        FontSize="12"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        IsVisible="{Binding ViewModel.HasNoInstances}"
                        Text="{Translate {x:Static loc:AppLanguageManager+Keys.bedrockpackageimportwindow_noAvailableInstances}}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding !IsBusy}"
                    ItemsSource="{Binding ViewModel.Instances}"
                    Padding="12,8,6,6"
                    SelectedItem="{Binding ViewModel.SelectedInstance}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:BedrockPackageInstanceItem">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Text="{Binding Version}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel IsVisible="{Binding ViewModel.RequiresUserId}" Spacing="6">
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Translate {x:Static loc:AppLanguageManager+Keys.bedrockpackageimportwindow_importWorldUser}}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding !IsBusy}"
                    ItemsSource="{Binding ViewModel.WorldUserIds}"
                    SelectedItem="{Binding ViewModel.SelectedWorldUserId}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding HasStatus}"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Margin="0,18,0,0"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Click="Cancel_OnClick"
                Content="{Translate {x:Static loc:AppLanguageManager+Keys.bedrockpackageimportwindow_cancel}}"
                IsEnabled="{Binding !IsBusy}" />
            <tio:IconButton
                Background="{DynamicResource SystemAccentColor}"
                Click="Import_OnClick"
                Content="{Binding ImportButtonText}"
                Foreground="White"
                IsEnabled="{Binding CanImport}" />
        </StackPanel>
    </Grid>
</tio:TioWindow>