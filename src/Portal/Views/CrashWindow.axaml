<tio:TioWindow
    Height="535"
    IsCloseBtnShow="{OnPlatform Default=True,
                                macOS=False}"
    IsMaxBtnShow="{OnPlatform Default=True,
                              macOS=False}"
    IsMinBtnShow="{OnPlatform Default=True,
                              macOS=False}"
    Title="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_windowTitle}}"
    Topmost="True"
    Width="880"
    d:DesignHeight="524"
    mc:Ignorable="d"
    x:Class="Portal.Views.CrashWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <tio:TioWindow.Resources>
        <SolidColorBrush Color="Transparent" x:Key="TitleBarBackgroundColor" />
    </tio:TioWindow.Resources>
    <tio:TioWindow.TitleBarLeftContent>
        <TextBlock
            FontSize="16"
            Margin="{OnPlatform '12,2,0,0',
                                macOS='78,2,0,0'}"
            Text="Portal"
            VerticalAlignment="Center" />
    </tio:TioWindow.TitleBarLeftContent>
    <DockPanel>
        <TextBlock
            DockPanel.Dock="Top"
            FontSize="24"
            Margin="25,0,0,0"
            Text="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_crashTitle}}" />
        <TextBlock
            DockPanel.Dock="Top"
            Margin="25,2,0,0"
            Text="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_unhandledExceptionDescription}}" />
        <StackPanel
            DockPanel.Dock="Bottom"
            Margin="10"
            Spacing="10">
            <Separator />
            <Panel>
                <tio:IconButton
                    Classes="Float"
                    Click="Button_OnClick"
                    Content="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_copyToClipboard}}"
                    HorizontalAlignment="Left">
                    <tio:IconButton.Icon>
                        <PathIcon
                            Data="{StaticResource ClipboardGeometry}"
                            Height="16"
                            Margin="0,-1,0,0"
                            Width="14" />
                    </tio:IconButton.Icon>
                </tio:IconButton>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="10">
                    <tio:IconButton
                        Classes="Float"
                        Click="Continue_OnClick"
                        Content="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_continueRunning}}"
                        Name="Continue">
                        <tio:IconButton.Icon>
                            <PathIcon
                                Data="{StaticResource CloseGeometry}"
                                Height="13"
                                Width="12" />
                        </tio:IconButton.Icon>
                    </tio:IconButton>
                    <tio:IconButton
                        Classes="Float"
                        Click="Exit_OnClick"
                        Content="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_exit}}"
                        Name="Exit">
                        <tio:IconButton.Icon>
                            <PathIcon
                                Data="{StaticResource ExitGeometry}"
                                Height="15"
                                Margin="0,0,-2,0"
                                Width="15" />
                        </tio:IconButton.Icon>
                    </tio:IconButton>
                    <tio:IconButton
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="Float"
                        Click="Restart_OnClick"
                        Content="{Translate {x:Static loc:AppLanguageManager+Keys.crashwindow_reopen}}"
                        Foreground="White"
                        Name="Restart">
                        <tio:IconButton.Icon>
                            <PathIcon
                                Data="{StaticResource ArrowClockwiseGeometry}"
                                Foreground="White"
                                Height="14"
                                Margin="0,0,-2,0"
                                Width="14" />
                        </tio:IconButton.Icon>
                    </tio:IconButton>
                </StackPanel>
            </Panel>
        </StackPanel>
        <ScrollViewer Classes="Flat" Margin="0,10,5,0">
            <SelectableTextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="25,0,5,0"
                Name="SelectableTextBlock" />
        </ScrollViewer>
    </DockPanel>
</tio:TioWindow>