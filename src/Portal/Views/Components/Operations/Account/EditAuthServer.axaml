<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.EditAuthServer"
    x:DataType="account:EditAuthServerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="510">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_0}}" />
        <tio:Form
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            LabelPosition="Top"
            Margin="0,10,0,15">
            <tio:FormItem Label="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_6}}">
                <StackPanel Spacing="4">
                    <DataValidationErrors>
                        <TextBox
                            PlaceholderText="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_1}}"
                            Text="{Binding ServerName}"
                            tio:FocusHelper.DialogFocusHint="True" />
                    </DataValidationErrors>
                </StackPanel>
            </tio:FormItem>
            <tio:FormItem Label="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_7}}">
                <StackPanel Spacing="4">
                    <DataValidationErrors>
                        <TextBox
                            PlaceholderText="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_2}}"
                            Text="{Binding ServerUrl}"
                            tio:FocusHelper.DialogFocusHint="True" />
                    </DataValidationErrors>
                </StackPanel>
            </tio:FormItem>
        </tio:Form>
        <DockPanel Grid.Row="2">
            <Button
                Command="{Binding DeleteCommand}"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_3}}"
                DockPanel.Dock="Left" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_4}}" />
                <Button Command="{Binding ConfirmCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.editauthserver_5}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>