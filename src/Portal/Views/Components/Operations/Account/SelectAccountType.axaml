<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.SelectAccountType"
    x:DataType="account:SelectAccountTypeViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid Margin="24" RowDefinitions="Auto, *, Auto">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.selectaccounttype_0}}" />
        <tio:Form
            Grid.Row="1"
            HorizontalAlignment="Center"
            LabelPosition="Top"
            Margin="0,-10,0,15">
            <tio:FormItem Label="">
                <StackPanel Spacing="4">
                    <DataValidationErrors>
                        <ListBox
                            ItemsSource="{Binding AuthServers}"
                            SelectedItem="{Binding SelectedServer}"
                            Width="368"
                            tio:FocusHelper.DialogFocusHint="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DataValidationErrors>
                </StackPanel>
            </tio:FormItem>
        </tio:Form>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.selectaccounttype_1}}" />

            <Button Command="{Binding NextCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.selectaccounttype_2}}" />
        </StackPanel>
    </Grid>
</UserControl>