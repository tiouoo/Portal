<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.BedrockMicrosoft"
    x:DataType="account:BedrockMicrosoftViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto,*,Auto"
        Width="510">
        <StackPanel>
            <TextBlock
                FontSize="16"
                FontWeight="600"
                Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.bedrockmicrosoft_title}}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,15">
            <TextBlock IsVisible="{Binding !IsError}" Text="{Binding Message}" />
            <SelectableTextBlock
                IsVisible="{Binding IsReady}"
                Margin="0,8,0,12"
                Text="{Binding Url}" />
            <tio:Skeleton
                Height="80"
                IsLoading="{Binding !IsReady}"
                IsVisible="{Binding !IsError}"
                Width="300">
                <Border Background="{DynamicResource PanelBackgroundColor}" CornerRadius="10">
                    <SelectableTextBlock
                        FontSize="30"
                        HorizontalAlignment="Center"
                        LetterSpacing="10"
                        Text="{Binding Code}"
                        VerticalAlignment="Center" />
                </Border>
            </tio:Skeleton>
            <TextBlock
                Foreground="Red"
                IsVisible="{Binding IsError}"
                Text="{Binding Error}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding Cancel}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.bedrockmicrosoft_cancelButton}}" />
            <Button
                Click="CopyCode"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.bedrockmicrosoft_copyCodeButton}}"
                IsEnabled="{Binding IsReady}" />
            <Button
                Click="OpenBrowser"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.bedrockmicrosoft_openBrowserButton}}"
                IsEnabled="{Binding IsReady}" />
        </StackPanel>
    </Grid>
</UserControl>