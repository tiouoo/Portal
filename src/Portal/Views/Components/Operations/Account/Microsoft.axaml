<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.Microsoft"
    x:DataType="account:MicrosoftAccountViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="510">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_title}}" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Margin="0,10,0,15">
            <TextBlock
                IsVisible="{Binding !IsError}"
                Margin="0,0,0,5"
                Text="{Binding Msg}" />
            <Border IsVisible="{Binding !IsAuthing}">
                <Border IsVisible="{Binding !IsError}">
                    <SelectableTextBlock
                        Foreground="{DynamicResource InnerForegroundColor}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsReady}"
                        Margin="1,0,0,20"
                        Text="{Binding Url}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                </Border>
            </Border>
            <Border IsVisible="{Binding !IsAuthing}">
                <tio:Skeleton
                    CornerRadius="10"
                    Height="80"
                    IsActive="True"
                    IsLoading="{Binding !IsReady}"
                    IsVisible="{Binding !IsError}"
                    Margin="0,0,0,20"
                    VerticalAlignment="Center"
                    Width="300">
                    <Border Background="{DynamicResource PanelBackgroundColor}">
                        <SelectableTextBlock
                            FontSize="30"
                            HorizontalAlignment="Center"
                            LetterSpacing="10"
                            Text="{Binding Code}"
                            VerticalAlignment="Center" />
                    </Border>
                </tio:Skeleton>
            </Border>
            <TextBlock
                Foreground="Red"
                IsVisible="{Binding IsError}"
                Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_errorMessage}}" />
            <TextBlock IsVisible="{Binding IsError}" Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_errorInfoPrefix}}" />
            <TextBlock IsVisible="{Binding IsError}" Text="{Binding Error}" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding Cancel}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_cancelButton}}" />
            <Button
                Command="{Binding Retry}"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_retryButton}}"
                IsVisible="{Binding IsError}" />
            <Button
                Click="CopyUrl"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_copyUrlButton}}"
                IsEnabled="{Binding IsReady}"
                IsVisible="{Binding !IsError}" />
            <Button
                Click="CopyCode"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_copyCodeButton}}"
                IsEnabled="{Binding IsReady}"
                IsVisible="{Binding !IsError}" />
            <Button
                Click="OpenBrowser"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.microsoft_openBrowserButton}}"
                IsEnabled="{Binding IsReady}"
                IsVisible="{Binding !IsError}" />
        </StackPanel>
    </Grid>
</UserControl>