<UserControl
    d:DesignHeight="600"
    d:DesignWidth="550"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.ChangeSkin"
    x:DataType="account:ChangeSkinViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lsv="clr-namespace:LiteSkinViewer3D.Avalonia.Controls;assembly=LiteSkinViewer.3D"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, Auto, *, Auto"
        Width="500">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Margin="0,0,0,10"
            Text="{Binding Title}" />
        <StackPanel
            Grid.Row="1"
            IsVisible="{Binding IsPreview, Converter={x:Static BoolConverters.Not}}"
            Margin="0,12,0,10"
            Spacing="4">
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource SukiMuteText}"
                Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_selectSkinFileLabel}}" />
            <tio:PathPicker
                FileFilter="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_fileFilter}}"
                SelectedPathsText="{Binding SkinPath}"
                Title="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_pathPickerTitle}}"
                UsePickerType="OpenFile" />
        </StackPanel>
        <Border
            Background="{DynamicResource LineColor}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Grid.Row="2"
            Margin="0,0,0,12">
            <lsv:SkinViewer3D
                Height="420"
                IsEnableAnimation="True"
                IsLightingEnabled="False"
                IsUpperLayerVisible="True"
                Name="SkinViewer"
                Skin="{Binding SkinPath}"
                Width="450" />
        </Border>
        <DockPanel Grid.Row="3">
            <CheckBox
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_lockViewCheckBox}}"
                DockPanel.Dock="Left"
                IsChecked="{Binding IsViewLocked}"
                IsCheckedChanged="OnIsViewLockedChanged"
                VerticalAlignment="Center" />
            <StackPanel
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                IsVisible="{Binding IsPreview, Converter={x:Static BoolConverters.Not}}"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_cancelButton}}" />
                <Button Command="{Binding ConfirmCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_confirmButton}}" />
            </StackPanel>
            <Button
                Command="{Binding CancelCommand}"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.changeskin_closeButton}}"
                HorizontalAlignment="Right"
                IsVisible="{Binding IsPreview}"
                Width="80" />
        </DockPanel>
    </Grid>
</UserControl>