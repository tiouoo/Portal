<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.RenameOfflineAccount"
    x:DataType="account:RenameOfflineAccountViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="510">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_0}}" />
        <tio:Form
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            LabelPosition="Top"
            Margin="0,10,0,15">
            <tio:FormItem Label="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_7}}">
                <DataValidationErrors>
                    <TextBox
                        PlaceholderText="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_1}}"
                        Text="{Binding RoleName}"
                        tio:FocusHelper.DialogFocusHint="True" />
                </DataValidationErrors>
            </tio:FormItem>
            <tio:FormItem Label="uuid">
                <StackPanel Spacing="4">
                    <DataValidationErrors>
                        <TextBox PlaceholderText="uuid" Text="{Binding Uuid}" />
                    </DataValidationErrors>
                    <CheckBox Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_2}}" IsChecked="{Binding SyncUuid}" />
                </StackPanel>
            </tio:FormItem>
            <tio:Banner
                Classes="Bordered"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_3}}"
                CornerRadius="10"
                Margin="0,0,0,0"
                Type="Warning">
                <tio:Banner.Header>
                    <TextBlock FontSize="15" Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_4}}" />
                </tio:Banner.Header>
            </tio:Banner>
        </tio:Form>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_5}}" />
            <Button Command="{Binding ConfirmCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.renameofflineaccount_6}}" />
        </StackPanel>
    </Grid>
</UserControl>