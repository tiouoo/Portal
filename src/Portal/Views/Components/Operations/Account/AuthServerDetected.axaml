<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.Operations.Account.AuthServerDetected"
    x:DataType="account:AuthServerDetectedViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:account="clr-namespace:Portal.Views.Components.Operations.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="510">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.authserverdetected_title}}" />
        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,15"
            Spacing="8">
            <TextBlock Text="{Binding ServerUrl}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.authserverdetected_cancelButton}}" />
            <Button Command="{Binding AddServerCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.authserverdetected_addServerButton}}" />
            <Button Command="{Binding LoginCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.authserverdetected_loginButton}}" />
        </StackPanel>
    </Grid>
</UserControl>