<UserControl
    d:DesignHeight="180"
    d:DesignWidth="420"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.MultiplayerPortDialog"
    x:DataType="components:MultiplayerPortDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="clr-namespace:Portal.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="420">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.multiplayerportdialog_title}}" />
        <TextBox
            Grid.Row="1"
            Margin="0,18"
            PlaceholderText="{Translate {x:Static loc:ComponentsLanguageManager+Keys.multiplayerportdialog_portPlaceholder}}"
            Text="{Binding Port}" />
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.multiplayerportdialog_cancelButton}}" />
            <Button Command="{Binding ConfirmCommand}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.multiplayerportdialog_confirmButton}}" />
        </StackPanel>
    </Grid>
</UserControl>