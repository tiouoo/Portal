<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Components.RandomMinecraft"
    x:DataType="components:RandomMinecraftViewModle"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="clr-namespace:Portal.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="510">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="16"
                FontWeight="600"
                Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.randomminecraft_title}}" />
            <StackPanel
                Margin="0,5,0,0"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.randomminecraft_wonPrefix}}" />
                <HyperlinkButton
                    Click="Button_OnClick"
                    Content="{Binding Instance.InstanceName}"
                    Tag="{Binding Instance}"
                    Theme="{StaticResource UnderlineHyperlinkButton}" />
                <TextBlock Text="{Translate {x:Static loc:ComponentsLanguageManager+Keys.randomminecraft_wonSuffix}}" />
            </StackPanel>
        </StackPanel>
        <Panel Grid.Row="2" Margin="0,30,0,0">
            <Button
                Command="{Binding Close}"
                Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.randomminecraft_closeButton}}"
                HorizontalAlignment="Left" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding Again}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.randomminecraft_againButton}}" />
                <Button Command="{Binding Complete}" Content="{Translate {x:Static loc:ComponentsLanguageManager+Keys.randomminecraft_completeButton}}" />
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>