<Window
    Background="Transparent"
    CanResize="False"
    FontFamily="{DynamicResource TioFontFamily}"
    FontSize="14"
    ShowInTaskbar="False"
    Title="Portal Overlay"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:Class="Portal.Views.SubWindows.OverlayWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Name="OverlayRoot" Opacity="0">
        <Grid Background="#66000000" Opacity="1" />

        <Grid
            Margin="30"
            Name="MainContent"
            RowDefinitions="Auto,*">
            <Button
                Classes="NoBorder"
                Click="CloseBtn_OnClick"
                Grid.Row="0"
                Height="48"
                HorizontalAlignment="Right"
                Name="CloseBtn"
                Width="48">
                <PathIcon
                    Data="F1 M640,640z M0,0z M183.1,137.4C170.6,124.9 150.3,124.9 137.8,137.4 125.3,149.9 125.3,170.2 137.8,182.7L275.2,320 137.9,457.4C125.4,469.9 125.4,490.2 137.9,502.7 150.4,515.2 170.7,515.2 183.2,502.7L320.5,365.3 457.9,502.6C470.4,515.1 490.7,515.1 503.2,502.6 515.7,490.1 515.7,469.8 503.2,457.3L365.8,320 503.1,182.6C515.6,170.1 515.6,149.8 503.1,137.3 490.6,124.8 470.3,124.8 457.8,137.3L320.5,274.7 183.1,137.4z"
                    Foreground="#FFFFFF"
                    Height="18"
                    Width="18" />
            </Button>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Left"
                Margin="15,0,0,0"
                VerticalAlignment="Bottom">
                <TextBlock
                    FontSize="28"
                    FontWeight="600"
                    Foreground="#FFFFFF"
                    IsVisible="False"
                    Margin="0,0,0,-0"
                    Name="LunarBlock"
                    Opacity="0.3"
                    Text="" />
                <StackPanel
                    Margin="0,0,0,-12"
                    Orientation="Horizontal"
                    Spacing="12">
                    <TextBlock
                        FontSize="36"
                        FontWeight="600"
                        Foreground="#FFFFFF"
                        Name="DateBlock"
                        Opacity="0.3"
                        Text="" />
                    <TextBlock
                        FontSize="36"
                        FontWeight="600"
                        Foreground="#FFFFFF"
                        Name="WeekBlock"
                        Opacity="0.3"
                        Text="" />
                </StackPanel>
                <TextBlock
                    FontSize="120"
                    FontWeight="950"
                    Foreground="#FFFFFF"
                    Name="TimeBlock"
                    Opacity="0.3" />
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Left"
            Margin="30,40,0,0"
            Orientation="Horizontal"
            Spacing="22"
            VerticalAlignment="Top">
            <Border
                Background="Transparent"
                Cursor="Hand"
                PointerPressed="InputElement_OnPointerPressed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Data="F1 M640,640z M0,0z M480,576L192,576C139,576,96,533,96,480L96,160C96,107,139,64,192,64L496,64C522.5,64,544,85.5,544,112L544,400C544,420.9,530.6,438.7,512,445.3L512,512C529.7,512 544,526.3 544,544 544,561.7 529.7,576 512,576L480,576z M192,448C174.3,448 160,462.3 160,480 160,497.7 174.3,512 192,512L448,512 448,448 192,448z M224,216C224,229.3,234.7,240,248,240L424,240C437.3,240 448,229.3 448,216 448,202.7 437.3,192 424,192L248,192C234.7,192,224,202.7,224,216z M248,288C234.7,288 224,298.7 224,312 224,325.3 234.7,336 248,336L424,336C437.3,336 448,325.3 448,312 448,298.7 437.3,288 424,288L248,288z"
                        Foreground="#fff"
                        Height="24"
                        Width="24" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="#FFFFFF"
                            Opacity="0.85"
                            Text="Instance" />
                        <TextBlock
                            FontSize="18"
                            Foreground="#FFFFFF"
                            Text="实例详情" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border
                Background="Transparent"
                Cursor="Hand"
                PointerPressed="Multiplayer_OnPointerPressed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Data="F1 M640,640z M0,0z M451.5,160C434.9,160 418.8,164.5 404.7,172.7 388.9,156.7 370.5,143.3 350.2,133.2 378.4,109.2 414.3,96 451.5,96 537.9,96 608,166 608,252.5 608,294 591.5,333.8 562.2,363.1L491.1,434.2C461.8,463.5 422,480 380.5,480 294.1,480 224,410 224,323.5 224,322 224,320.5 224.1,319 224.6,301.3 239.3,287.4 257,287.9 274.7,288.4 288.6,303.1 288.1,320.8 288.1,321.7 288.1,322.6 288.1,323.4 288.1,374.5 329.5,415.9 380.6,415.9 405.1,415.9 428.6,406.2 446,388.8L517.1,317.7C534.4,300.4 544.2,276.8 544.2,252.3 544.2,201.2 502.8,159.8 451.7,159.8z M307.2,237.3C305.3,236.5 303.4,235.4 301.7,234.2 289.1,227.7 274.7,224 259.6,224 235.1,224 211.6,233.7 194.2,251.1L123.1,322.2C105.8,339.5 96,363.1 96,387.6 96,438.7 137.4,480.1 188.5,480.1 205,480.1 221.1,475.7 235.2,467.5 251,483.5 269.4,496.9 289.8,507 261.6,530.9 225.8,544.2 188.5,544.2 102.1,544.2 32,474.2 32,387.7 32,346.2 48.5,306.4 77.8,277.1L148.9,206C178.2,176.7 218,160.2 259.5,160.2 346.1,160.2 416,230.8 416,317.1 416,318.4 416,319.7 416,321 415.6,338.7 400.9,352.6 383.2,352.2 365.5,351.8 351.6,337.1 352,319.4 352,318.6 352,317.9 352,317.1 352,283.4 334,253.8 307.2,237.5z"
                        Foreground="#fff"
                        Height="24"
                        Width="24" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="#FFFFFF"
                            Opacity="0.85"
                            Text="Multiplayer" />
                        <TextBlock
                            FontSize="18"
                            Foreground="#FFFFFF"
                            Text="联机大厅" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock
            Foreground="#FFFFFF"
            HorizontalAlignment="Left"
            Margin="10,6,0,0"
            Name="VersionBox"
            Opacity="0.85"
            Text="Portal v1.0.0"
            VerticalAlignment="Top" />

        <Border
            Background="{DynamicResource PopupBackgroundColor}"
            BorderBrush="{DynamicResource PopupBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Margin="25"
            Name="InstanceBorder"
            Opacity="0"
            Padding="0,5,0,0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Duration="0:0:0.1" Property="Opacity" />
                </Transitions>
            </Border.Transitions>
            <Panel>
                <ContentControl Name="InstanceContentControl" />
                <Button
                    Background="Transparent"
                    Click="CloseInstance"
                    HorizontalAlignment="Right"
                    Margin="0,0,5,0"
                    Theme="{StaticResource TransparentButton}"
                    VerticalAlignment="Top">
                    <PathIcon
                        Data="F1 M640,640z M0,0z M183.1,137.4C170.6,124.9 150.3,124.9 137.8,137.4 125.3,149.9 125.3,170.2 137.8,182.7L275.2,320 137.9,457.4C125.4,469.9 125.4,490.2 137.9,502.7 150.4,515.2 170.7,515.2 183.2,502.7L320.5,365.3 457.9,502.6C470.4,515.1 490.7,515.1 503.2,502.6 515.7,490.1 515.7,469.8 503.2,457.3L365.8,320 503.1,182.6C515.6,170.1 515.6,149.8 503.1,137.3 490.6,124.8 470.3,124.8 457.8,137.3L320.5,274.7 183.1,137.4z"
                        Height="18"
                        Width="18" />
                </Button>
            </Panel>
        </Border>
    </Grid>
</Window>