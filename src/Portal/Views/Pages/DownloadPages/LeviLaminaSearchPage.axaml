<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.DownloadPages.LeviLaminaSearchPage"
    x:DataType="local:LeviLaminaSearchViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:local="clr-namespace:Portal.Views.Pages.DownloadPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:owned="clr-namespace:Portal.Views.Components"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12,0,12,0">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <DockPanel MinHeight="32">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock FontSize="24" Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_pageTitle}}" />
                    <TextBlock
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Margin="10,9,0,0"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,0">
                <Button
                    Command="{Binding SearchCommand}"
                    Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_search}}"
                    DockPanel.Dock="Right" />
                <TextBox
                    KeyDown="SearchBox_OnKeyDown"
                    Margin="0,0,10,0"
                    PlaceholderText="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_searchPlaceholder}}"
                    Text="{Binding SearchText}">
                    <TextBox.InnerRightContent>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="18"
                            FontWeight="Thin"
                            Foreground="{DynamicResource InnerForegroundColor}"
                            Text="&#xe615;" />
                    </TextBox.InnerRightContent>
                </TextBox>
            </DockPanel>
            <Button
                Command="{Binding SearchCommand}"
                Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.bedrockresourcesearchpage_retry}}"
                HorizontalAlignment="Left"
                IsVisible="{Binding HasError}" />
        </StackPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <Panel>
                <ItemsRepeater ItemsSource="{Binding Results}" Margin="0,0,10,0">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemHeight="117"
                            MinItemWidth="740"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:LeviLaminaSearchResultItem">
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Cursor="Hand"
                                Name="ResourceCard"
                                Padding="10"
                                PointerPressed="Card_OnPointerPressed"
                                Tag="{Binding}">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem
                                            Click="Download_OnClick"
                                            Header="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_install}}"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="18"
                                                    FontWeight="Thin"
                                                    Text="&#xe613;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="OpenProject_OnClick"
                                            Header="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_openProject}}"
                                            Tag="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="18"
                                                    FontWeight="Thin"
                                                    Text="&#xe628;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Border.Styles>
                                    <Style Selector="Border#ResourceCard Border#ResourceActions">
                                        <Setter Property="Opacity" Value="0" />
                                    </Style>
                                    <Style Selector="Border#ResourceCard:pointerover Border#ResourceActions">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </Border.Styles>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                                    <Border
                                        Background="{DynamicResource TranslucentBackgroundColor}"
                                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,-4,-4"
                                        Name="ResourceActions"
                                        Opacity="0"
                                        Padding="5,2"
                                        VerticalAlignment="Bottom"
                                        ZIndex="1">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition
                                                    Duration="0:0:0.15"
                                                    Easing="SineEaseOut"
                                                    Property="Opacity" />
                                            </Transitions>
                                        </Border.Transitions>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button
                                                Classes="Icon"
                                                Click="Download_OnClick"
                                                Tag="{Binding}"
                                                Theme="{StaticResource TransparentButton}"
                                                ToolTip.Tip="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_install}}">
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="15"
                                                    Text="&#xe647;" />
                                            </Button>
                                            <Button
                                                Classes="Icon"
                                                Click="OpenProject_OnClick"
                                                Tag="{Binding}"
                                                Theme="{StaticResource TransparentButton}"
                                                ToolTip.Tip="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_openProject}}">
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="15"
                                                    Text="&#xe60c;" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border
                                            Background="{DynamicResource TranslucentBorderBrush}"
                                            CornerRadius="12"
                                            Height="56"
                                            Width="56">
                                            <Grid>
                                                <owned:OwnedAdvancedImage
                                                    CornerRadius="12"
                                                    Height="56"
                                                    Loader="{Binding ImageLoader}"
                                                    Source="{Binding DisplayAvatarUrl}"
                                                    Stretch="UniformToFill"
                                                    Width="56" />
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="32"
                                                    FontWeight="Thin"
                                                    HorizontalAlignment="Center"
                                                    IsVisible="{Binding !HasIcon}"
                                                    Text="&#xe631;"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel
                                                Margin="0,2,0,0"
                                                Orientation="Horizontal"
                                                Spacing="3">
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    Margin="0,-1,0,0"
                                                    Text="&#xe644;"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    Text="{Binding Metadata}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,3,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Background="{DynamicResource TranslucentBackgroundColor}"
                                                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="7,1">
                                                            <TextBlock FontSize="11" Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="1"
                                        Margin="3,8,3,0"
                                        MaxLines="2"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ItemsRepeater
                    IsVisible="{Binding IsLoading}"
                    ItemsSource="{x:Static owned:ResourceSearchSkeleton.Items}"
                    Margin="0,0,10,0">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemHeight="117"
                            MinItemWidth="740"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <controls:Skeleton
                                            CornerRadius="12"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            IsActive="True"
                                            IsLoading="True"
                                            Width="56" />
                                        <StackPanel
                                            Margin="10,1,0,0"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                            <controls:Skeleton
                                                CornerRadius="4"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                IsActive="True"
                                                IsLoading="True"
                                                Width="150" />
                                            <controls:Skeleton
                                                CornerRadius="3"
                                                Height="12"
                                                HorizontalAlignment="Left"
                                                IsActive="True"
                                                IsLoading="True"
                                                Width="105" />
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <controls:Skeleton
                                                    CornerRadius="999"
                                                    Height="17"
                                                    HorizontalAlignment="Left"
                                                    IsActive="True"
                                                    IsLoading="True"
                                                    Width="52" />
                                                <controls:Skeleton
                                                    CornerRadius="999"
                                                    Height="17"
                                                    HorizontalAlignment="Left"
                                                    IsActive="True"
                                                    IsLoading="True"
                                                    Width="40" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Margin="3,5,3,0" Spacing="5">
                                        <controls:Skeleton
                                            CornerRadius="3"
                                            Height="12"
                                            HorizontalAlignment="Stretch"
                                            IsActive="True"
                                            IsLoading="True" />
                                        <controls:Skeleton
                                            CornerRadius="3"
                                            Height="12"
                                            HorizontalAlignment="Left"
                                            IsActive="True"
                                            IsLoading="True"
                                            Width="190" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Margin="0,36,0,0"
                    Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.levilaminasearchpage_noResults}}" />
            </Panel>
        </controls:ScrollView>
    </DockPanel>
</UserControl>
