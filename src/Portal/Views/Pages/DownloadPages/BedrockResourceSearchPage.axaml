<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.DownloadPages.BedrockResourceSearchPage"
    x:DataType="local:BedrockResourceSearchViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Pages.DownloadPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:owned="clr-namespace:Portal.Views.Components"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <DockPanel Margin="12,0,12,12">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <DockPanel MinHeight="32">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock FontSize="24" Text="{Binding PageTitle}" />
                    <TextBlock
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Margin="5,10,0,0"
                        Text="{Binding StatusText}" />
                </StackPanel>
                <tio:Pagination
                    Command="{Binding GoToPageCommand}"
                    CommandParameter="{Binding CurrentPage}"
                    CurrentPage="{Binding CurrentPage}"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding HasResults}"
                    PageSize="40"
                    TotalCount="{Binding TotalCount}" />
            </DockPanel>
            <DockPanel>
                <Button
                    Command="{Binding SearchCommand}"
                    Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.bedrockresourcesearchpage_search}}"
                    DockPanel.Dock="Right" />
                <ComboBox
                    DockPanel.Dock="Right"
                    ItemsSource="{Binding SortOptions}"
                    Margin="0,0,10,0"
                    SelectedItem="{Binding SelectedSort}"
                    Width="140">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox
                    KeyDown="SearchBox_OnKeyDown"
                    Margin="0,0,10,0"
                    PlaceholderText="{Binding SearchPlaceholder}"
                    Text="{Binding SearchText}">
                    <TextBox.InnerRightContent>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="18"
                            FontWeight="Thin"
                            Foreground="{DynamicResource InnerForegroundColor}"
                            Text="&#xe615;" />
                    </TextBox.InnerRightContent>
                </TextBox>
            </DockPanel>
            <Button
                Command="{Binding RetryCommand}"
                Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.bedrockresourcesearchpage_retry}}"
                HorizontalAlignment="Left"
                IsVisible="{Binding HasError}" />
        </StackPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <Panel>
            <ItemsRepeater ItemsSource="{Binding Results}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="117"
                        MinItemWidth="300"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:JavaResourceSearchResultItem">
                        <Border
                            Background="{DynamicResource TranslucentBackgroundColor}"
                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Cursor="Hand"
                            Name="ResourceCard"
                            Padding="10"
                            PointerPressed="Result_OnPointerPressed">
                            <Border.Styles>
                                <Style Selector="Border#ResourceCard Border#ResourceActions">
                                    <Setter Property="Opacity" Value="0" />
                                </Style>
                                <Style Selector="Border#ResourceCard:pointerover Border#ResourceActions">
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </Border.Styles>
                            <Panel>
                                <Border
                                    Background="{DynamicResource TranslucentBackgroundColor}"
                                    BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,-4,-4"
                                    Name="ResourceActions"
                                    Padding="5,2"
                                    VerticalAlignment="Bottom"
                                    ZIndex="1">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition
                                                Duration="0:0:0.15"
                                                Easing="SineEaseOut"
                                                Property="Opacity" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button
                                            Classes="Icon"
                                            Click="Favorite_OnClick"
                                            Tag="{Binding}"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{Translate {x:Static loc:DownloadsLanguageManager+Keys.bedrockresourcesearchpage_unfavoriteToolTip}}">
                                            <Grid>
                                                <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe620;" FontSize="16" IsVisible="{Binding !IsFavorite}" />
                                                <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe61c;" FontSize="16" IsVisible="{Binding IsFavorite}" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            Classes="Icon"
                                            Click="Download_OnClick"
                                            Tag="{Binding}"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{Translate {x:Static loc:DownloadsLanguageManager+Keys.bedrockresourcesearchpage_downloadToolTip}}">
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe647;" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Border
                                            Background="{DynamicResource TranslucentBorderBrush}"
                                            CornerRadius="12"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            Width="56">
                                            <owned:OwnedAdvancedImage
                                                CornerRadius="12"
                                                Loader="{Binding ImageLoader}"
                                                Source="{Binding IconUrl}" />
                                        </Border>
                                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Text="{Binding Metadata}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="3,5,3,0"
                                        MaxLines="2"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow" />
                                </DockPanel>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <Border
                Background="{DynamicResource TranslucentBackgroundColor}"
                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsLoadingPlaceholder}"
                Margin="0,24,0,0"
                Padding="10"
                VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="200" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        HorizontalAlignment="Center"
                        Text="{Binding LoadingText}" />
                </StackPanel>
            </Border>
            <TextBlock
                FontSize="14"
                Foreground="{DynamicResource InnerForegroundColor}"
                HorizontalAlignment="Center"
                IsVisible="{Binding IsEmpty}"
                Margin="0,36,0,0"
                Text="{Binding EmptyText}"
                VerticalAlignment="Top" />
            </Panel>
        </controls:ScrollView>
    </DockPanel>
</UserControl>