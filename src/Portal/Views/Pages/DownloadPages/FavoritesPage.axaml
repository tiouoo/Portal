<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.DownloadPages.FavoritesPage"
    x:DataType="local:FavoritesPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:controls="clr-namespace:SmoothScroll.Avalonia.Controls;assembly=SmoothScroll.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Pages.DownloadPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:owned="clr-namespace:Portal.Views.Components"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12,0,12,12">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <DockPanel>
                <TextBlock FontSize="24" Text="收藏夹" />
            </DockPanel>
            <DockPanel>
                <DropDownButton Content="编辑" DockPanel.Dock="Left">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem
                                Classes="hide-icon"
                                Command="{Binding AddCollectionCommand}"
                                Header="新建收藏夹" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="Import_OnClick"
                                Header="导入收藏夹" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="Export_OnClick"
                                Header="导出当前收藏夹" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="Edit_OnClick"
                                Header="编辑当前收藏夹" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <ComboBox
                    DockPanel.Dock="Left"
                    ItemsSource="{Binding Collections}"
                    Margin="8,0,0,0"
                    SelectedItem="{Binding SelectedCollection}"
                    Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    DockPanel.Dock="Left"
                    ItemsSource="{Binding Editions}"
                    Margin="10,0,0,0"
                    SelectedItem="{Binding SelectedEdition}"
                    Width="120" />
                <ComboBox
                    DockPanel.Dock="Left"
                    IsVisible="{Binding ShowKindFilter}"
                    ItemsSource="{Binding Kinds}"
                    Margin="10,0,0,0"
                    SelectedItem="{Binding SelectedKind}"
                    Width="130" />
                <TextBox
                    Margin="10,0"
                    PlaceholderText="搜索收藏内容"
                    Text="{Binding SearchText}" />
            </DockPanel>
        </StackPanel>
        <controls:ScrollView Classes="Flat" Margin="0,12,0,0">
            <ItemsRepeater ItemsSource="{Binding Items}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="117"
                        MinItemWidth="300"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:FavoriteResourceItem">
                        <Border
                            Background="{DynamicResource TranslucentBackgroundColor}"
                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Cursor="Hand"
                            Name="FavoriteCard"
                            Padding="10"
                            PointerPressed="Item_OnPointerPressed">
                            <Border.Styles>
                                <Style Selector="Border#FavoriteCard Border#ResourceActions"><Setter Property="Opacity" Value="0" /></Style>
                                <Style Selector="Border#FavoriteCard:pointerover Border#ResourceActions"><Setter Property="Opacity" Value="1" /></Style>
                            </Border.Styles>
                            <Panel>
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Border
                                            Background="{DynamicResource TranslucentBorderBrush}"
                                            CornerRadius="10"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            Width="56">
                                            <owned:OwnedAdvancedImage
                                                CornerRadius="10"
                                                Loader="{Binding ImageLoader}"
                                                Source="{Binding IconUrl}" />
                                        </Border>
                                        <StackPanel
                                            DockPanel.Dock="Top"
                                            Margin="10,1,0,0"
                                            VerticalAlignment="Top">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLines="2"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                MaxLines="1"
                                                Text="{Binding SourceText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Bottom"
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="3,6,3,0"
                                        MaxLines="2"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow" />
                                </DockPanel>
                                <Border
                                    Background="{DynamicResource TranslucentBackgroundColor}"
                                    BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,-4,-4"
                                    Name="ResourceActions"
                                    Padding="5,2"
                                    VerticalAlignment="Bottom"
                                    ZIndex="1">
                                    <Border.Transitions><Transitions><DoubleTransition Duration="0:0:0.15" Easing="SineEaseOut" Property="Opacity" /></Transitions></Border.Transitions>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button
                                            Classes="Icon"
                                            Click="Favorite_OnClick"
                                            Tag="{Binding}"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="取消收藏">
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M305,151.1L320,171.8 335,151.1C360,116.5 400.2,96 442.9,96 516.4,96 576,155.6 576,229.1L576,231.7C576,343.9 436.1,474.2 363.1,529.9 350.7,539.3 335.5,544 320,544 304.5,544 289.2,539.4 276.9,529.9 203.9,474.2 64,343.9 64,231.7L64,229.1C64,155.6 123.6,96 197.1,96 239.8,96 280,116.5 305,151.1z"
                                                Height="16"
                                                Width="16" />
                                        </Button>
                                        <Button
                                            Classes="Icon"
                                            Click="Download_OnClick"
                                            Tag="{Binding}"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="下载">
                                            <PathIcon
                                                Data="{StaticResource DownloadGeometry}"
                                                Height="12"
                                                Width="14" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>
