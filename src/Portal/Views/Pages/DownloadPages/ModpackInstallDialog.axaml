<UserControl
    d:DesignHeight="300"
    d:DesignWidth="480"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.DownloadPages.ModpackInstallDialog"
    x:DataType="local:ModpackInstallDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Pages.DownloadPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto,Auto,Auto,Auto"
        Width="480">
        <StackPanel Spacing="4">
            <TextBlock FontSize="16" Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_0}}" />
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_1}}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,18,0,0"
            Spacing="6">
            <TextBlock Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_2}}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding MinecraftFolders}"
                Padding="10,5,5,5"
                SelectedItem="{Binding SelectedMinecraftFolder}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ModpackInstallFolderItem">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource InnerForegroundColor}"
                                Text="{Binding Path}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding HasNoMinecraftFolders}"
                Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_3}}" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="0,18,0,0"
            Spacing="6">
            <TextBlock Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_4}}" />
            <TextBox Text="{Binding InstanceId}" />
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding InstanceIdExists}"
                Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_5}}" />
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding HasInvalidInstanceId}"
                Text="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_6}}" />
        </StackPanel>
        <DockPanel
            Grid.Row="3"
            LastChildFill="False"
            Margin="0,22,0,0">
            <Button
                Click="SaveAs_Click"
                Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_7}}"
                DockPanel.Dock="Left"
                IsVisible="{Binding ShowSaveAs}" />
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Cancel_Click" Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_8}}" />
                <Button
                    Click="Install_Click"
                    Content="{Translate {x:Static loc:DownloadsLanguageManager+Keys.modpackinstalldialog_9}}"
                    IsEnabled="{Binding CanInstall}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>