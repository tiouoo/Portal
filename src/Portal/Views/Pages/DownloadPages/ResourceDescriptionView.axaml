<UserControl
    Margin="0,10,0,0"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.DownloadPages.ResourceDescriptionView"
    x:DataType="local:ResourceDetailsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Pages.DownloadPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:owned="clr-namespace:Portal.Views.Components"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <controls:ScrollView>
        <Panel>
            <ItemsControl IsVisible="{Binding !IsLoading}" ItemsSource="{Binding DescriptionControls}" />
            <owned:ResourceDescriptionSkeleton IsVisible="{Binding IsLoading}" />
        </Panel>
    </controls:ScrollView>
</UserControl>
