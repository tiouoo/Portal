<UserControl
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.StartPage"
    x:DataType="pages:StartPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:classes="clr-namespace:Portal.Core.Minecraft.Classes;assembly=Portal.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entries="clr-namespace:Portal.Classes.Entries"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate DataType="entries:AggregatedSearchEntry" x:Key="SearchItemTemplate">
            <StackPanel Margin="4,0">
                <TextBlock
                    MaxLines="1"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <StackPanel
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="{Binding TypeDescription}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        MaxLines="1"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="12,2,5,10">
        <Grid DockPanel.Dock="Top" Margin="0,40,7,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <tio:AutoCompleteBox
                DropDownOpened="SearchBox_OnDropDownOpened"
                FilterMode="None"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource SearchItemTemplate}"
                MaxDropDownHeight="336"
                PlaceholderText="{Binding SearchPlaceholder}"
                Populating="SearchBox_OnPopulating"
                SelectionChanged="SearchBox_OnSelectionChanged"
                ValueMemberBinding="{ReflectionBinding Title}"
                x:Name="SearchBox">
                <tio:AutoCompleteBox.InnerLeftContent>
                    <Panel Width="{Binding Bounds.Width, ElementName=SearchModeComboBox}" />
                </tio:AutoCompleteBox.InnerLeftContent>
                <tio:AutoCompleteBox.InnerRightContent>
                    <PathIcon
                        Data="F1 M512,512z M0,0z M416,208C416,253.9,401.1,296.3,376,330.7L502.6,457.4C515.1,469.9 515.1,490.2 502.6,502.7L490.1,515.2 469.8,515.2 457.3,502.7L330.7,376C296.3,401.1 253.9,416 208,416 93.1,416 0,322.9 0,208 0,93.1 93.1,0 208,0 322.9,0 416,93.1 416,208z M208,352A144,144,0,1,0,208,64A144,144,0,1,0,208,352z"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Height="14"
                        Width="14" />
                </tio:AutoCompleteBox.InnerRightContent>
            </tio:AutoCompleteBox>
            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Left"
                ItemsSource="{Binding SearchModes}"
                Margin="12,0,0,0"
                MaxDropDownHeight="999"
                SelectedItem="{Binding SelectedSearchMode}"
                Theme="{StaticResource BareComboBox}"
                VerticalAlignment="Stretch"
                x:Name="SearchModeComboBox">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="pages:SearchMode">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <PathIcon
                                Data="{Binding IconData}"
                                Height="16"
                                IsVisible="{Binding IconData, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Width="16" />
                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Rectangle
            DockPanel.Dock="Top"
            Fill="{DynamicResource TranslucentBorderBrush}"
            Height="1"
            Margin="0,0,0,12" />
        <tio:ScrollView Classes="Flat" SizeChanged="StartPage_OnSizeChanged">
            <StackPanel Margin="0,0,7,0">
                <StackPanel IsVisible="{Binding HasRecentPlays}">
                    <StackPanel Margin="0,0,0,12" Spacing="8">
                        <DockPanel Margin="5,0,10,0">
                            <StackPanel
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="15"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Text="最近游玩" />
                                <Button Click="RefreshRecentPlays_Click" Theme="{StaticResource TransparentButton}">
                                    <PathIcon
                                        Data="F1 M640,640z M0,0z M500.7,138.7L512,149.4 512,96C512,78.3 526.3,64 544,64 561.7,64 576,78.3 576,96L576,224C576,241.7,561.7,256,544,256L416,256C398.3,256 384,241.7 384,224 384,206.3 398.3,192 416,192L463.9,192 456.3,184.8C456.1,184.6 455.9,184.4 455.7,184.2 380.7,109.2 259.2,109.2 184.2,184.2 109.2,259.2 109.2,380.7 184.2,455.7 259.2,530.7 380.7,530.7 455.7,455.7 463.9,447.5 471.2,438.8 477.6,429.6 487.7,415.1 507.7,411.6 522.2,421.7 536.7,431.8 540.2,451.8 530.1,466.3 521.6,478.5 511.9,490.1 501,501 401,601 238.9,601 139,501 39.1,401 39,239 139,139 238.9,39.1 400.7,39 500.7,138.7z"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Height="16"
                                        Width="16" />
                                </Button>
                            </StackPanel>
                            <Button
                                Command="{Binding ToggleRecentPlaysCommand}"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding CanExpandRecentPlays}"
                                Margin="0,0,10,0"
                                Theme="{StaticResource TransparentButton}"
                                VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Binding ToggleRecentPlaysText}" />
                            </Button>
                            <Button
                                Command="{Binding ToggleBlockedRecentPlaysCommand}"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding HasBlockedRecentPlaysOnly}"
                                Margin="0,0,8,0"
                                Theme="{StaticResource TransparentButton}"
                                VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Binding ToggleBlockedRecentPlaysText}" />
                            </Button>
                        </DockPanel>
                        <ItemsRepeater HorizontalAlignment="Stretch" ItemsSource="{Binding RecentPlays}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemHeight="120"
                                    MinItemWidth="270"
                                    MinRowSpacing="12"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate DataType="pages:RecentPlayItem">
                                    <Border
                                        Background="{DynamicResource TranslucentBackgroundColor}"
                                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Height="120"
                                        Name="RecentBorder"
                                        PointerPressed="RecentPlayItem_OnPointerPressed">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Click="QuickPlay_Click"
                                                    Header="游玩"
                                                    IsVisible="{Binding CanQuickPlay}"
                                                    Tag="{Binding Target}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Click="RecentPlayCreateShortcut_Click"
                                                    Header="快捷方式"
                                                    Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M434.8,54.1C446.7,62.7,451.1,78.3,445.7,91.9L367.3,288 512,288C525.5,288 537.5,296.4 542.1,309.1 546.7,321.8 542.8,336 532.5,344.6L244.5,584.6C233.2,594 217.1,594.5 205.2,585.9 193.3,577.3 188.9,561.7 194.3,548.1L272.7,352 128,352C114.5,352 102.5,343.6 97.9,330.9 93.3,318.2 97.2,304 107.5,295.4L395.5,55.4C406.8,46,422.9,45.5,434.8,54.1z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Click="RecentPlayFavorite_Click"
                                                    Header="{Binding FavoriteHeaderText}"
                                                    Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Click="BlockRecentPlay_Click"
                                                    Header="{Binding BlockHeaderText}"
                                                    Tag="{Binding Target}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M231,231C240.4,221.6,255.6,221.6,264.9,231L319.9,286 374.9,231C384.3,221.6 399.5,221.6 408.8,231 418.1,240.4 418.2,255.6 408.8,264.9L353.8,319.9 408.8,374.9C418.2,384.3 418.2,399.5 408.8,408.8 399.4,418.1 384.2,418.2 374.9,408.8L319.9,353.8 264.9,408.8C255.5,418.2 240.3,418.2 231,408.8 221.7,399.4 221.6,384.2 231,374.9L286,319.9 231,264.9C221.6,255.5,221.6,240.3,231,231z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Styles>
                                            <Style Selector="Button#QuickPlayButton">
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                            <Style Selector="Button#UnfavoritedRecentPlayButton PathIcon">
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                            <Style Selector="Button#UnfavoritedRecentPlayButton PathIcon#SolidStar">
                                                <Setter Property="Opacity" Value="1" />
                                            </Style>
                                            <Style Selector="Button#UnfavoritedRecentPlayButton">
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                            <Style Selector="Border#RecentBorder:pointerover Button#QuickPlayButton, Border#RecentBorder:pointerover Button#UnfavoritedRecentPlayButton">
                                                <Setter Property="Opacity" Value="1" />
                                            </Style>
                                        </Border.Styles>
                                        <DockPanel Margin="12,12,12,5">
                                            <DockPanel DockPanel.Dock="Top">
                                                <Border
                                                    ClipToBounds="True"
                                                    CornerRadius="10"
                                                    Height="40"
                                                    Margin="0,0,8,0"
                                                    Width="40">
                                                    <Image
                                                        Height="40"
                                                        Source="{Binding Icon}"
                                                        Width="40" />
                                                </Border>
                                                <StackPanel Margin="2,3,0,0" Spacing="2">
                                                    <TextBlock
                                                        MaxLines="1"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource InnerForegroundColor}"
                                                        IsVisible="{Binding HasSubtitle}"
                                                        MaxLines="1"
                                                        Text="{Binding SubtitleText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel
                                                DockPanel.Dock="Bottom"
                                                Margin="2,8,0,5"
                                                Spacing="2">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    MaxLines="1"
                                                    Text="{Binding InstanceName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    IsVisible="{Binding !IsServer}"
                                                    MaxLines="1"
                                                    Text="{Binding Details}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    IsVisible="{Binding IsServer}"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <Ellipse
                                                        Fill="{Binding StatusBrush}"
                                                        Height="7"
                                                        VerticalAlignment="Center"
                                                        Width="7" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{Binding StatusBrush}"
                                                        MaxLines="1"
                                                        Text="{Binding StatusText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{Binding PingBrush}"
                                                        IsVisible="{Binding HasPing}"
                                                        MaxLines="1"
                                                        Text="{Binding PingText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource InnerForegroundColor}"
                                                        IsVisible="{Binding HasPlayers}"
                                                        MaxLines="1"
                                                        Text="{Binding PlayersText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                                <DockPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource InnerForegroundColor}"
                                                        Text="{Binding RelativeTime}" />
                                                    <StackPanel
                                                        DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="QuickPlay_Click"
                                                            HorizontalAlignment="Right"
                                                            IsVisible="{Binding CanQuickPlay}"
                                                            Margin="0,0,2,2"
                                                            Padding="4,-2,2,0"
                                                            Tag="{Binding Target}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            ToolTip.Tip="快速进入"
                                                            x:Name="QuickPlayButton">
                                                            <PathIcon
                                                                Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                Height="15"
                                                                Width="15" />
                                                            <Button.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition
                                                                        Duration="0:0:0.15"
                                                                        Easing="SineEaseOut"
                                                                        Property="Opacity" />
                                                                </Transitions>
                                                            </Button.Transitions>
                                                        </Button>
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="RecentPlayFavorite_Click"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding !IsFavorite}"
                                                            Padding="4,-4,4,0"
                                                            Tag="{Binding}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            x:Name="UnfavoritedRecentPlayButton">
                                                            <Grid>
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    Width="15"
                                                                    x:Name="SolidStar" />
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M320.1,32C329.1,32 337.4,37.1 341.5,45.1L415,189.3 574.9,214.7C583.8,216.1 591.2,222.4 594,231 596.8,239.6 594.5,249 588.2,255.4L473.7,369.9 499,529.8C500.4,538.7 496.7,547.7 489.4,553 482.1,558.3 472.4,559.1 464.4,555L320.1,481.6 175.8,555C167.8,559.1 158.1,558.3 150.8,553 143.5,547.7 139.8,538.8 141.2,529.8L166.4,369.9 52,255.4C45.6,249 43.4,239.6 46.2,231 49,222.4 56.3,216.1 65.3,214.7L225.2,189.3 298.8,45.1C302.9,37.1,311.2,32,320.2,32z M320.1,108.8L262.3,222C258.8,228.8,252.3,233.6,244.7,234.8L119.2,254.8 209,344.7C214.4,350.1,216.9,357.8,215.7,365.4L195.9,490.9 309.2,433.3C316,429.8 324.1,429.8 331,433.3L444.3,490.9 424.5,365.4C423.3,357.8,425.8,350.1,431.2,344.7L521,254.8 395.5,234.8C387.9,233.6,381.4,228.8,377.9,222L320.1,108.8z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    Width="15" />
                                                            </Grid>
                                                            <Button.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition
                                                                        Duration="0:0:0.15"
                                                                        Easing="SineEaseOut"
                                                                        Property="Opacity" />
                                                                </Transitions>
                                                            </Button.Transitions>
                                                        </Button>
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="RecentPlayFavorite_Click"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding IsFavorite}"
                                                            Padding="4,-4,4,0"
                                                            Tag="{Binding}"
                                                            Theme="{StaticResource TransparentButton}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    VerticalAlignment="Center"
                                                                    Width="15" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Text="已收藏"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="BlockRecentPlay_Click"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding IsBlocked}"
                                                            Margin="0,-4,0,0"
                                                            Padding="4,0,4,0"
                                                            Tag="{Binding Target}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            x:Name="BlockedRecentPlayButton">
                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M231,231C240.4,221.6,255.6,221.6,264.9,231L319.9,286 374.9,231C384.3,221.6 399.5,221.6 408.8,231 418.1,240.4 418.2,255.6 408.8,264.9L353.8,319.9 408.8,374.9C418.2,384.3 418.2,399.5 408.8,408.8 399.4,418.1 384.2,418.2 374.9,408.8L319.9,353.8 264.9,408.8C255.5,418.2 240.3,418.2 231,408.8 221.7,399.4 221.6,384.2 231,374.9L286,319.9 231,264.9C221.6,255.5,221.6,240.3,231,231z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    Width="15" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    MaxLines="1"
                                                                    Text="已屏蔽"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <Rectangle
                        Fill="{DynamicResource TranslucentBorderBrush}"
                        Height="1"
                        Margin="0,0,0,12" />
                </StackPanel>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Button
                                Background="Transparent"
                                Click="ButtonOpenInstance_OnClick"
                                Theme="{StaticResource TransparentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <!--  <PathIcon  -->
