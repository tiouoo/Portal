<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstanceDetailPage"
    x:DataType="pages:InstanceDetailPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <DockPanel>
        <controls:ScrollView
            Classes="Flat"
            DockPanel.Dock="Left"
            Margin="7,0,00,10"
            Width="140">
            <tio:NavMenu
                Margin="0,0,10,0"
                Name="NavMenu"
                Theme="{StaticResource FlatScrollBarTheme}">
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Dashboard}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Dashboard}}"
                    IsSelected="True" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Files}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Storage}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Mods}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Mods}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:ResourcePacks}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_ResourcePacks}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:ShaderPacks}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_ShaderPacks}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Saves}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Saves}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Servers}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Servers}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Screenshots}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Screenshots}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Logs}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Logs}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:CrashReports}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_CrashReports}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockMods}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Mods}}"
                    IsVisible="{Binding SupportsBedrockMods}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockResourcePacks}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_ResourcePacks}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockBehaviorPacks}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Storage0}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockWorlds}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Saves}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockServers}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Servers}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockWorldTemplates}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Storage1}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:BedrockSkins}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Storage2}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Screenshots}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Screenshots}}"
                    IsVisible="{Binding IsBedrock}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:ConfigFiles}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Storage3}}"
                    IsVisible="{Binding IsJava}" />
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type instancePages:Properties}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.instancedetailpage_Storage4}}" />
            </tio:NavMenu>
        </controls:ScrollView>
        <Rectangle
            DockPanel.Dock="Left"
            Fill="{DynamicResource TranslucentBorderBrush}"
            Margin="0,0,0,10"
            Width="1" />
        <TransitioningContentControl Content="{Binding CurrentPage}" Margin="12,3,12,0">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </DockPanel>
</UserControl>