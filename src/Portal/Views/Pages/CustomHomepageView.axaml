<UserControl x:Class="Portal.Views.Pages.CustomHomepageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Portal.Views.Pages">
  <UserControl.Styles>
    <Style Selector="local|MyCard">
      <Setter Property="Background" Value="{DynamicResource TranslucentBackgroundColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TranslucentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,15" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Margin="15,12,15,8" FontSize="13" FontWeight="Bold" Text="{TemplateBinding Title}" />
              <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" Margin="15,5,15,15" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="local|MyButton, local|MyIconButton, local|MyIconTextButton, local|MyExtraButton, local|MyExtraTextButton">
      <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="local|MyButton:pointerover, local|MyIconButton:pointerover, local|MyIconTextButton:pointerover, local|MyExtraButton:pointerover, local|MyExtraTextButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
    </Style>
    <Style Selector="local|MyHint">
      <Setter Property="Background" Value="{DynamicResource TranslucentBackgroundColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="local|MyTextButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Panel x:Name="ContentHost" Margin="18" />
  </ScrollViewer>
</UserControl>
