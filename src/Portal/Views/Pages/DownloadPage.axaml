<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.DownloadPage"
    x:DataType="pages:DownloadPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:downloadPages="clr-namespace:Portal.Views.Pages.DownloadPages"
    xmlns:loc="using:Portal.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <controls:ScrollView
            Classes="Flat"
            DockPanel.Dock="Left"
            HorizontalAlignment="Left"
            Margin="7,0,10,10"
            Width="170">
            <tio:NavMenu
                Margin="0,0,10,0"
                Name="NavMenu"
                Theme="{StaticResource FlatScrollBarTheme}">
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type downloadPages:FavoritesPage}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_Favorites}}">
                    <tio:NavMenuItem.Icon>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="17"
                            Margin="0,-1"
                            Text="&#xe66e;" />
                    </tio:NavMenuItem.Icon>
                </tio:NavMenuItem>
                <tio:NavMenuItem
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_JavaEdition}}"
                    IsVerticalCollapsed="{Binding !Data.ConfigEntry.DownloadJavaEditionExpanded}"
                    Name="JavaEditionNavItem">
                    <tio:NavMenuItem.Icon>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="17"
                            Margin="0,-1"
                            Padding="2,0,0,0"
                            Text="&#xe65f;" />
                    </tio:NavMenuItem.Icon>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:VanillaInstallation}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_GameClient}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="18"
                                Margin="0,-1"
                                Padding="1,0,0,0"
                                Text="&#xe657;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:ModSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_Mods}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="18"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe658;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:ModpackSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_Modpacks}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe659;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:ResourcePackSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_ResourcePacks}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe65a;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:ShaderPackSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_ShaderPacks}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="1,0,0,0"
                                Text="&#xe65c;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:DataPackSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_DataPacks}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe65b;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:SaveSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_Saves}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="16"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe65d;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                </tio:NavMenuItem>
                <tio:NavMenuItem
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_BedrockEdition}}"
                    IsVerticalCollapsed="{Binding !Data.ConfigEntry.DownloadBedrockEditionExpanded}"
                    Name="BedrockEditionNavItem">
                    <tio:NavMenuItem.Icon>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="16"
                            Margin="-1,-1,0,-1"
                            Padding="1,0"
                            Text="&#xe670;" />
                    </tio:NavMenuItem.Icon>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:BedrockInstallation}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_GameClient}}"
                        IsVisible="{Binding IsBedrockInstallationSupported}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="18"
                                Margin="0,-1"
                                Padding="1,0,0,0"
                                Text="&#xe657;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:BedrockResourcePackSearchPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_BedrockResourcePacks}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe659;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem Command="{Binding NavigateTypeCommand}" CommandParameter="{x:Type downloadPages:LeviLaminaSearchPage}">
                        <controls:NavMenuItem.Header>
                            <TextBlock Margin="0,0,-20,0" Text="LeviLamina" />
                        </controls:NavMenuItem.Header>
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="16"
                                Margin="0,-1"
                                Padding="4,1,0,0"
                                Text="&#xe678;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                </tio:NavMenuItem>
                <tio:NavMenuItem
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_Others}}"
                    IsVerticalCollapsed="{Binding !Data.ConfigEntry.DownloadOthersExpanded}"
                    Name="OthersNavItem">
                    <tio:NavMenuItem.Icon>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="17"
                            Margin="0,-1"
                            Padding="1,0,0,0"
                            Text="&#xe668;" />
                    </tio:NavMenuItem.Icon>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:JavaDownloadPage}"
                        Header="Java">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="3,0,0,0"
                                Text="&#xe65f;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                    <tio:NavMenuItem
                        Command="{Binding NavigateTypeCommand}"
                        CommandParameter="{x:Type downloadPages:CustomDownloadPage}"
                        Header="{Translate {x:Static loc:PagesLanguageManager+Keys.downloadpage_CustomDownload}}">
                        <tio:NavMenuItem.Icon>
                            <TextBlock
                                FontFamily="{StaticResource IconFont}"
                                FontSize="17"
                                Margin="0,-1"
                                Padding="2,0,0,0"
                                Text="&#xe65e;" />
                        </tio:NavMenuItem.Icon>
                    </tio:NavMenuItem>
                </tio:NavMenuItem>
            </tio:NavMenu>
        </controls:ScrollView>

        <TransitioningContentControl Content="{Binding CurrentPage}" Margin="0,10,10,10">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </DockPanel>
</UserControl>
