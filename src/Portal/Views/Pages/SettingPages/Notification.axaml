<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.Notification"
    x:DataType="settingPages:Notification"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <StackPanel Spacing="15">
        <TextBlock FontSize="26" Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_0}}" />
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_1}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                SelectedIndex="{Binding Data.ConfigEntry.NoticeWay}"
                SelectionChanged="SelectingItemsControl_OnSelectionChanged">
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_2}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_3}}" />
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="15">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_4}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <StackPanel Spacing="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_5}}" />
                    <ToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowUsingAccountTip}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_6}}" />
                    <ToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowDragDropTip}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_7}}" />
                    <ToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowUpdateTip}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Spacing="15">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_8}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <StackPanel Spacing="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_9}}" />
                    <ToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowMinecraftNews}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_10}}" />
                    <ToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowRecentPlays}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>