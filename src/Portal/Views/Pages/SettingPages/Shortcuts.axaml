<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.Shortcuts"
    x:DataType="settingPages:ShortcutsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:Portal.Views.Components.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:Portal.Module" xmlns:loc="using:Portal.Localization">
    <UserControl.Styles>
        <Style Selector="controls|ShortcutKeyGestureInput /template/ Button#PART_ClearButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="15">
        <TextBlock FontSize="26" Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.shortcuts_title}}" />
        <TextBox
            HorizontalAlignment="Stretch"
            Margin="0,0,0,-10"
            MaxWidth="560"
            PlaceholderText="{Translate {x:Static loc:SettingsLanguageManager+Keys.shortcuts_searchPlaceholder}}"
            Text="{Binding SearchText}">
            <TextBox.InnerRightContent>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph magnifying-glass}" FontSize="14" Foreground="{DynamicResource InnerForegroundColor}" Margin="0,0,2,0" />
            </TextBox.InnerRightContent>
        </TextBox>
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="False"
            Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.shortcuts_shortcutHint}}"
            TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="settingPages:ShortcutCategoryViewModel">
                    <StackPanel
                        IsVisible="{Binding !IsEmpty}"
                        Margin="0,12,0,4"
                        Spacing="6">
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settingPages:ShortcutItemViewModel">
                                    <Grid ColumnDefinitions="*,220" Margin="0,3,0,3">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <Grid ColumnDefinitions="*,Auto" Grid.Column="1">
                                            <Grid Grid.Column="0">
                                                <controls:ShortcutKeyGestureInput
                                                    Gesture="{Binding Gesture, Mode=TwoWay}"
                                                    HorizontalContentAlignment="Left"
                                                    VerticalAlignment="Stretch" />
                                                <TextBlock
                                                    Foreground="{DynamicResource TextBoxInnerForeground}"
                                                    IsHitTestVisible="False"
                                                    IsVisible="{Binding IsEmpty}"
                                                    Margin="8,0,0,0"
                                                    Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.shortcuts_none}}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <Button
                                                Click="ResetOne_OnClick"
                                                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.shortcuts_resetToDefault}}"
                                                Grid.Column="1"
                                                IsVisible="{Binding IsNotDefault}"
                                                Margin="6,0,0,0"
                                                Padding="8,2"
                                                Tag="{Binding}"
                                                ToolTip.Tip="{Translate {x:Static loc:SettingsLanguageManager+Keys.shortcuts_resetToDefaultHint}}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>