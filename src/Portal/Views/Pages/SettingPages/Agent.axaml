<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.Agent"
    x:DataType="settingPages:Agent"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="15">
        <TextBlock FontSize="26" Text="网络代理" />
        <StackPanel Spacing="5">
            <Label
                Content="GitHub 镜像加速"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.EnableGithubMirror}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding Data.ConfigEntry.EnableGithubMirror}" Spacing="5">
            <Label
                Content="镜像源地址"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox PlaceholderText="https://ghfast.top" Text="{Binding Data.ConfigEntry.GithubMirrorUrl}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text=" *前缀式镜像直接填写站点地址，如 https://ghfast.top 或 ghproxy.net" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text=" *其他格式可用 {url} 占位符代表原始下载地址，如 https://example.com/?q={url}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="使用代理服务器"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.EnableProxyServer}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="禁用系统代理"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.DisableSystemProxy}" IsEnabled="{Binding Data.ConfigEntry.CanDisableSystemProxy}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text=" *单独启用时，所有网络请求将直接连接，不使用系统代理" />
        </StackPanel>
        <StackPanel IsVisible="{Binding Data.ConfigEntry.EnableProxyServer}" Spacing="5">
            <Label
                Content="代理服务器地址"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox PlaceholderText="http://127.0.0.1:7890" Text="{Binding Data.ConfigEntry.ProxyServer}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="自定义 UserAgent"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.EnableCustomUserAgent}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding Data.ConfigEntry.EnableCustomUserAgent}" Spacing="5">
            <Label
                Content="UserAgent"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox PlaceholderText="{Binding DefaultAgent}" Text="{Binding Data.ConfigEntry.CustomUserAgent}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text=" *默认UserAgent: " />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Binding DefaultAgent}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
