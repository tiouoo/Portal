<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.DefaultBehavior"
    x:DataType="settingPages:DefaultBehavior"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="15">
        <TextBlock FontSize="26" Text="默认行为" />
        <StackPanel Spacing="5">
            <Label
                Content="默认页面"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox
                DisplayMemberBinding="{Binding Title}"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding DefaultPages}"
                SelectedItem="{Binding SelectedDefaultPage}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="新标签页内容"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Data.ConfigEntry.NewTabContent}">
                <ComboBoxItem Content="新标签页" />
                <ComboBoxItem Content="起始页" />
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="启动器可见性"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Data.ConfigEntry.PortalVisibleMode}">
                <ComboBoxItem Content="游戏启动后保持不变" />
                <ComboBoxItem Content="游戏启动后退出启动器" />
                <ComboBoxItem Content="游戏启动后隐藏，游戏退出后重新显示" />
                <ComboBoxItem Content="游戏启动后最小化" />
                <ComboBoxItem Content="游戏启动后最小化，游戏退出后恢复" />
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="文件选择器"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Data.ConfigEntry.FilePicker}">
                <ComboBoxItem Content="系统对话框" />
                <ComboBoxItem Content="接管对话框" />
                <!-- <ComboBoxItem Content="输入路径" /> -->
            </ComboBox>
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text=" *需要重启程序" />
        </StackPanel>
        <StackPanel IsVisible="{Binding CanRegisterProtocol}" Spacing="15">
            <Label
                Content="Portal 协议"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <DockPanel>
                <TextBlock
                    DockPanel.Dock="Left"
                    FontSize="14"
                    HorizontalAlignment="Left"
                    Text="注册后，可在浏览器通过协议调起启动器"
                    VerticalAlignment="Center" />
                <HyperlinkButton
                    Click="RegisterProtocol_OnClick"
                    Content="{Binding RegisterProtocolButtonText}"
                    DockPanel.Dock="Right"
                    FontSize="13"
                    HorizontalAlignment="Right"
                    Theme="{StaticResource TransparentHyperlinkButton}" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
