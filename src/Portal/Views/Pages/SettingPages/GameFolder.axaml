<UserControl
    Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.GameFolder"
    x:DataType="settingPages:GameFolder"
    xmlns="https://github.com/avaloniaui"
    xmlns:classes="clr-namespace:Portal.Core.Minecraft.Classes;assembly=Portal.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <StackPanel Spacing="15">
        <TextBlock FontSize="26" Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_title}}" />
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_defaultFolder}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Data.ConfigEntry.InstallableMinecraftFolders}"
                SelectedItem="{Binding Data.ConfigEntry.DefaultMinecraftFolder}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="classes:MinecraftFolderEntry">
                        <TextBlock>
                            <Run Text="[" />
                            <Run Text="{Binding FolderName}" />
                            <Run Text="]" />
                            <Run Text="{Binding FolderPath}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="5">
            <DockPanel Margin="0,4,0,0">
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_folderManagement}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    HorizontalAlignment="Left"
                    Margin="5,0,0,0" />
                <HyperlinkButton
                    Click="Button_OnClick"
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_addFolder}}"
                    FontSize="13"
                    HorizontalAlignment="Right"
                    Margin="0,0,5,5"
                    Theme="{StaticResource TransparentHyperlinkButton}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Data.ConfigEntry.MinecraftFolders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="classes:MinecraftFolderEntry">
                        <tio:TioExpander
                            Background="{DynamicResource TranslucentBackgroundColor}"
                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                            BorderThickness="1"
                            HeaderHeight="52"
                            IconHeight="14"
                            IconMargin="0,0,10,0"
                            IconWidth="14">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe611;" FontSize="24" HorizontalAlignment="Center" Margin="8,0,4,2" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,8,0,8" Spacing="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FolderName}" />
                                            <TextBlock Text="·" VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Text="{Binding FolderTypeDescription}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Label
                                            Content="{Binding FolderPath}"
                                            FontSize="13"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <tio:TioExpander.Content>
                                <StackPanel>
                                    <Separator />
                                    <StackPanel Margin="10" Spacing="15">
                                        <StackPanel Margin="5,0,0,0" Spacing="5">
                                            <Panel>
                                                <Label
                                                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_folderName}}"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    HorizontalAlignment="Left" />
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,10,0"
                                                    Orientation="Horizontal"
                                                    Spacing="10"
                                                    VerticalAlignment="Bottom">
                                                    <HyperlinkButton
                                                        Click="Button1_OnClick"
                                                        Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_removeFolder}}"
                                                        FontSize="13"
                                                        Foreground="Red"
                                                        Tag="{Binding}"
                                                        Theme="{StaticResource TransparentHyperlinkButton}" />
                                                    <HyperlinkButton
                                                        Command="{Binding OpenFolder}"
                                                        CommandParameter="{Binding ElementName=Root}"
                                                        Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_openFolder}}"
                                                        FontSize="13"
                                                        Theme="{StaticResource TransparentHyperlinkButton}" />
                                                </StackPanel>
                                            </Panel>
                                            <TextBox Text="{Binding FolderName, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Panel Margin="10,0">
                                            <tio:Descriptions HorizontalAlignment="Left" LabelPosition="Top">
                                                <tio:DescriptionsItem Label="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_instanceCount}}">
                                                    <TextBlock>
                                                        <Run FontSize="32" Text="{Binding InstanceCount}" />
                                                        <Run Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_countSuffix}}" />
                                                    </TextBlock>
                                                </tio:DescriptionsItem>
                                            </tio:Descriptions>
                                            <tio:Descriptions
                                                HorizontalAlignment="Right"
                                                LabelPosition="Top"
                                                Margin="0,0,-60,0">
                                                <tio:DescriptionsItem Label="{Translate {x:Static loc:SettingsLanguageManager+Keys.gamefolder_folderSize}}">
                                                    <TextBlock>
                                                        <Run FontSize="32" Text="{Binding FolderSize}" />
                                                        <Run Text="{Binding SizeUnit}" />
                                                    </TextBlock>
                                                </tio:DescriptionsItem>
                                            </tio:Descriptions>
                                        </Panel>
                                    </StackPanel>
                                </StackPanel>
                            </tio:TioExpander.Content>
                        </tio:TioExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>