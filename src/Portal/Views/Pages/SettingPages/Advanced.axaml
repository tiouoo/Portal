<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.Advanced"
    x:DataType="settingPages:Advanced"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="15">
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_autoSetChineseLanguage}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.AutoSetChineseLanguage}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="0,-3,0,0"
                Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_autoSetChineseLanguageHint}}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsOverlaySupported}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_gameOverlay}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.EnableGameOverlay}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="0,-3,0,0"
                Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_gameOverlayHint}}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_gameFullscreen}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ToggleSwitch IsChecked="{Binding Data.ConfigEntry.EnableFullscreen}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="0,-3,0,0"
                Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_gameFullscreenHint}}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_launcherVisibility}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Data.ConfigEntry.PortalVisibleMode}">
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_keepUnchanged}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_exitLauncher}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_hideAndRestore}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_minimizeLauncher}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_minimizeAndRestore}}" />
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_minecraftWindowTitle}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox
                AcceptsReturn="True"
                PlaceholderText="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_leaveEmptyForDefault}}"
                Text="{Binding Data.ConfigEntry.OverrideMinecraftWindowTitle}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_minecraftWindowSize}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid
                ColumnDefinitions="*,*"
                IsEnabled="{Binding !Data.ConfigEntry.EnableFullscreen}"
                VerticalAlignment="Top">
                <TextBox
                    AcceptsReturn="True"
                    Grid.Column="0"
                    InnerLeftContent="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_width}}"
                    Margin="0,0,10,0"
                    Text="{Binding Data.ConfigEntry.MinecraftWindowWidth}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />
                <TextBox
                    AcceptsReturn="True"
                    Grid.Column="1"
                    InnerLeftContent="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_height}}"
                    Margin="10,0,0,0"
                    Text="{Binding Data.ConfigEntry.MinecraftWindowHeight}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_jvmArgs}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox
                AcceptsReturn="True"
                PlaceholderText="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_leaveEmptyByDefault}}"
                Text="{Binding Data.ConfigEntry.JvmArgs}"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_beforeLaunchCommand}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox
                AcceptsReturn="True"
                PlaceholderText="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_beforeLaunchCommandHint}}"
                Text="{Binding Data.ConfigEntry.BeforeLaunchCommand}"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_afterLaunchCommand}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox
                AcceptsReturn="True"
                PlaceholderText="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_afterLaunchCommandHint}}"
                Text="{Binding Data.ConfigEntry.AfterLaunchCommand}"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_packagedCommand}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBox
                AcceptsReturn="True"
                PlaceholderText="{Translate {x:Static loc:SettingsLanguageManager+Keys.advanced_launchCommandPlaceholder}}"
                Text="{Binding Data.ConfigEntry.PackagedCommand}"
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
        </StackPanel>
    </StackPanel>
</UserControl>
