<UserControl
    Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.SettingPages.Java"
    x:DataType="settingPages:Java"
    xmlns="https://github.com/avaloniaui"
    xmlns:classes="clr-namespace:Portal.Core.Minecraft.Instance.Java;assembly=Portal.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:Portal.Views.Pages.SettingPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="15">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_maxMemory}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}" />
                <Button
                    Click="OptimizeMemory_Click"
                    FontSize="13"
                    IsVisible="{Binding IsWindows}"
                    Theme="{StaticResource TransparentButton}">
                    <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_optimizeMemory}}" />
                </Button>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasMemoryStatus}">
                <Slider
                    Grid.Column="0"
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding TotalMemoryMb}"
                    Minimum="512"
                    Name="Slider"
                    TickFrequency="256" />
                <Border
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    Width="75">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding Data.ConfigEntry.MinecraftMaxMemory, StringFormat={}{0:0} MB}"
                        VerticalAlignment="Center" />
                </Border>
            </Grid>
            <Border
                Background="{DynamicResource TranslucentBorderBrush}"
                ClipToBounds="True"
                CornerRadius="10"
                Height="10"
                IsVisible="{Binding HasMemoryStatus}"
                Margin="0,3,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding SystemMemoryWidth}" />
                        <ColumnDefinition Width="{Binding MinecraftMemoryWidth}" />
                        <ColumnDefinition Width="{Binding RemainingMemoryWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="3,0,0,3" />
                    <Border Background="{DynamicResource SystemAccentColorLight2}" Grid.Column="1" />
                </Grid>
            </Border>
            <Grid
                ColumnDefinitions="*,Auto"
                IsVisible="{Binding HasMemoryStatus}"
                Margin="0,1,0,0">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Binding SystemMemoryDescription}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Grid.Column="1"
                    Text="{Binding MinecraftMemoryDescription}" />
            </Grid>
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding HasMemoryWarning}"
                Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_memoryExceedWarning}}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindows}">
            <StackPanel Spacing="2">
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_autoCleanMemoryBeforeLaunch}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Padding="0" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_autoCleanMemoryBeforeLaunchHint}}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                IsChecked="{Binding Data.ConfigEntry.AutoOptimizeMemoryBeforeGameLaunch}"
                VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindowsOrLinux}">
            <StackPanel Spacing="2">
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_autoHighPerformanceGpu}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Padding="0" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_autoHighPerformanceGpuHint}}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                IsChecked="{Binding Data.ConfigEntry.AutoSetJavaHighPerformanceGpu}"
                VerticalAlignment="Center" />
        </Grid>
        <DockPanel Margin="0,-2,0,0">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_javaManagement}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="False"
                Margin="0,0,0,0" />
            <StackPanel
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <HyperlinkButton
                    Click="DeepScan_Click"
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_deepScan}}"
                    FontSize="13"
                    Name="DeepScanButton"
                    Theme="{StaticResource TransparentHyperlinkButton}" />
                <HyperlinkButton
                    Click="AutoScan_Click"
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_autoScan}}"
                    FontSize="13"
                    Theme="{StaticResource TransparentHyperlinkButton}" />
                <HyperlinkButton
                    Click="AddJava_Click"
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_addManually}}"
                    FontSize="13"
                    Theme="{StaticResource TransparentHyperlinkButton}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Margin="0,-32,0,0" Spacing="6">
            <ItemsControl ItemsSource="{Binding MainstreamJavaOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="settingPages:JavaVersionOption">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="14"
                                Margin="0,8,0,-2"
                                Text="{Binding DisplayName}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox
                                    Grid.Column="0"
                                    Height="34"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding Runtimes}"
                                    SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="classes:JavaRuntimeEntry">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Click="ManualSelectJava_Click"
                                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_manualSelect}}"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Tag="{Binding}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Expander
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            Header="{Translate {x:Static loc:SettingsLanguageManager+Keys.java_versions}}"
            IsExpanded="False"
            Margin="1,4,0,0">
            <ListBox ItemsSource="{Binding Data.ConfigEntry.JavaRuntimes}" Margin="10,0,10,10">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem Button.delete-btn">
                        <Setter Property="Opacity" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Button.delete-btn">
                        <Setter Property="Opacity" Value="1" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="classes:JavaRuntimeEntry">
                        <Grid ColumnDefinitions="*,Auto" Margin="3,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Text="{Binding JavaPath}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Classes="delete-btn"
                                Click="RemoveJava_Click"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Tag="{Binding}"
                                Theme="{StaticResource TransparentButton}"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="14"
                                    FontWeight="Thin"
                                    Text="&#xe640;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
    </StackPanel>
</UserControl>
