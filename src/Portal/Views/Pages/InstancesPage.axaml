<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancesPage"
    x:DataType="pages:InstancesPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:classes="clr-namespace:Portal.Core.Minecraft.Classes;assembly=Portal.Core"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:widgets="clr-namespace:Portal.Views.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources />
    <DockPanel Margin="12,0,0,10">
        <widgets:InstanceListToolbar
            DockPanel.Dock="Top"
            Margin="0,0,12,10"
            ShowFolderFilter="True"
            ShowOpenInstancesTitle="False" />
        <controls:ScrollView
            Background="Transparent"
            Classes="Flat"
            DockPanel.Dock="Bottom"
            Margin="0,0,5,5"
            Name="MainScrollViewer">
            <ItemsRepeater
                ItemsSource="{Binding FilteredMinecraftInstances}"
                Margin="2,0,9,0"
                VerticalAlignment="Top">

                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemHeight="125"
                        MinItemWidth="270"
                        MinRowSpacing="12"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="classes:MinecraftInstance">
                        <widgets:InstanceCard />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>
