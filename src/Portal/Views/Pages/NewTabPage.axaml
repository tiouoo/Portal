<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.NewTabPage"
    x:DataType="pages:NewTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:classes="clr-namespace:Portal.Core.Minecraft.Classes;assembly=Portal.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:widgets="clr-namespace:Portal.Views.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <UserControl.Resources />
    <UserControl.Styles>
        <Style Selector="widgets|RecentPlayCard">
            <Setter Property="ShowQuickPlayWhenPossible" Value="False" />
        </Style>
    </UserControl.Styles>
    <tio:ScrollView Classes="Flat" Margin="12,2,5,10">
        <StackPanel Margin="0,0,7,0" Spacing="0">
            <DockPanel VerticalAlignment="Top">
                <StackPanel
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Margin="12,0,0,0"
                    Name="StackPanel"
                    Spacing="12"
                    VerticalAlignment="Top">
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="114"
                        Width="260">
                        <Grid>
                            <StackPanel
                                IsVisible="{Binding !HasRecentInstance}"
                                Margin="0,0,0,8"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Data="F1 M640,640z M0,0z M448,128C554,128 640,214 640,320 640,426 554,512 448,512L192,512C86,512 0,426 0,320 0,214 86,128 192,128L448,128z M192,240C178.7,240,168,250.7,168,264L168,296 136,296C122.7,296 112,306.7 112,320 112,333.3 122.7,344 136,344L168,344 168,376C168,389.3 178.7,400 192,400 205.3,400 216,389.3 216,376L216,344 248,344C261.3,344 272,333.3 272,320 272,306.7 261.3,296 248,296L216,296 216,264C216,250.7,205.3,240,192,240z M432,336C414.3,336 400,350.3 400,368 400,385.7 414.3,400 432,400 449.7,400 464,385.7 464,368 464,350.3 449.7,336 432,336z M496,240C478.3,240 464,254.3 464,272 464,289.7 478.3,304 496,304 513.7,304 528,289.7 528,272 528,254.3 513.7,240 496,240z"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Width="30" />
                                <TextBlock
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    HorizontalAlignment="Center"
                                    Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_0}}" />
                            </StackPanel>
                            <Panel>
                                <DockPanel
                                    Background="Transparent"
                                    IsVisible="{Binding HasRecentInstance}"
                                    Margin="12,10"
                                    PointerPressed="RecentInstanceCard_OnPointerPressed"
                                    Tag="{Binding RecentInstance}">


                                    <StackPanel
                                        DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Border
                                            ClipToBounds="True"
                                            CornerRadius="12"
                                            Height="42"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,0"
                                            Width="42">
                                            <Image
                                                Height="42"
                                                Source="{Binding RecentInstance.Icon}"
                                                Width="42" />
                                        </Border>
                                        <TextBlock
                                            Margin="2,3,0,0"
                                            MaxLines="2"
                                            Text="{Binding RecentInstance.InstanceName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWithOverflow"
                                            VerticalAlignment="Center"
                                            Width="170" />
                                    </StackPanel>
                                    <StackPanel
                                        DockPanel.Dock="Bottom"
                                        Margin="2,1,0,2"
                                        Spacing="2"
                                        VerticalAlignment="Bottom">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Margin="0,4,0,0"
                                            Text="{Binding RecentInstance.FolderName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Text="{Binding RecentInstance.ShortDisplay}" />
                                        <Panel>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                HorizontalAlignment="Left"
                                                Text="{Binding RecentInstance.DisplayLastPlayTime}" />
                                        </Panel>
                                    </StackPanel>
                                </DockPanel>
                                <HyperlinkButton
                                    Click="ContinueGame_Click"
                                    Content="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_1}}"
                                    FontSize="13"
                                    HorizontalAlignment="Right"
                                    IsVisible="{Binding HasRecentInstance}"
                                    Margin="0,0,16,10"
                                    Theme="{StaticResource TransparentHyperlinkButton}"
                                    VerticalAlignment="Bottom" />
                            </Panel>
                        </Grid>
                    </Border>
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="115">
                        <Grid>
                            <StackPanel
                                IsVisible="{Binding !HasRecentPlayTargetItem}"
                                Margin="0,0,0,8"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Data="F1 M640,640z M0,0z M480,96C515.3,96,544,124.7,544,160L544,480C544,515.3,515.3,544,480,544L160,544C124.7,544,96,515.3,96,480L96,160C96,124.7,124.7,96,160,96L480,96z M368,360C368,373.3 378.7,384 392,384 405.3,384 416,373.3 416,360L416,248C416,234.7,405.3,224,392,224L280,224C266.7,224,256,234.7,256,248 256,261.3 266.7,272 280,272L334.1,272 231.1,375C221.7,384.4 221.7,399.6 231.1,408.9 240.5,418.2 255.7,418.3 265,408.9L368,305.9 368,360z"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Width="30" />
                                <TextBlock
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    HorizontalAlignment="Center"
                                    Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_2}}" />
                            </StackPanel>
                            <Panel>
                                <DockPanel
                                    Background="Transparent"
                                    IsVisible="{Binding HasRecentPlayTargetItem}"
                                    Margin="12,10"
                                    PointerPressed="RecentPlayTargetCard_OnPointerPressed"
                                    Tag="{Binding RecentPlayTargetItem.Target}">
                                    <DockPanel DockPanel.Dock="Top">
                                        <Border
                                            ClipToBounds="True"
                                            CornerRadius="10"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            Width="40">
                                            <Image
                                                Height="40"
                                                Source="{Binding RecentPlayTargetItem.Icon}"
                                                Width="40" />
                                        </Border>
                                        <StackPanel Margin="2,3,0,0" Spacing="2">
                                            <TextBlock
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                IsVisible="{Binding RecentPlayTargetItem.HasSubtitle}"
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.SubtitleText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel
                                        DockPanel.Dock="Bottom"
                                        Margin="2,6,0,4"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding RecentPlayTargetItem.InstanceName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            IsVisible="{Binding !RecentPlayTargetItem.IsServer}"
                                            MaxLines="1"
                                            Text="{Binding RecentPlayTargetItem.Details}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            IsVisible="{Binding RecentPlayTargetItem.IsServer}"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{Binding RecentPlayTargetItem.StatusBrush}"
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.StatusText}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{Binding RecentPlayTargetItem.PingBrush}"
                                                IsVisible="{Binding RecentPlayTargetItem.HasPing}"
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.PingText}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                IsVisible="{Binding RecentPlayTargetItem.HasPlayers}"
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.PlayersText}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DockPanel>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Text="{Binding RecentPlayTargetItem.RelativeTime}" />
                                            <HyperlinkButton
                                                Click="ContinueTargetGame_Click"
                                                Content="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_1}}"
                                                DockPanel.Dock="Right"
                                                FontSize="13"
                                                HorizontalAlignment="Right"
                                                IsVisible="{Binding RecentPlayTargetItem.CanQuickPlay}"
                                                Tag="{Binding RecentPlayTargetItem.Target}"
                                                Theme="{StaticResource TransparentHyperlinkButton}" />
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Panel>
                        </Grid>
                    </Border>
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="87">
                        <StackPanel Margin="13,13,0,10">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Top">
                                <PathIcon
                                    Data="F1 M640,640z M0,0z M320,64C461.4,64 576,178.6 576,320 576,461.4 461.4,576 320,576 178.6,576 64,461.4 64,320 64,178.6 178.6,64 320,64z M296,184L296,320C296,328,300,335.5,306.7,340L402.7,404C413.7,411.4 428.6,408.4 436,397.3 443.4,386.2 440.4,371.4 429.3,364L344,307.2 344,184C344,170.7 333.3,160 320,160 306.7,160 296,170.7 296,184z"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Height="20"
                                    Width="20" />
                                <TextBlock
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_3}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel
                                Margin="3,10,0,0"
                                Orientation="Horizontal"
                                Spacing="7">
                                <TextBlock VerticalAlignment="Center">
                                    <Run FontSize="28" Text="{Binding DisplayTotalPlayTime}" />
                                    <Run
                                        FontSize="18"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Text="{Binding PlayTimeUnit}" />
                                </TextBlock>
                                <Rectangle
                                    Fill="{DynamicResource TranslucentBorderBrush}"
                                    Margin="0,3"
                                    Width="1" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run FontSize="28" Text="{Binding DisplayTotalPlaySessions}" />
                                    <Run
                                        FontSize="14"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_4}}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition
                                Duration="0:0:0.1"
                                Easing="SineEaseOut"
                                Property="Opacity" />
                        </Transitions>
                    </StackPanel.Transitions>
                </StackPanel>
                <StackPanel Spacing="12">
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="16"
                        Height="340"
                        Name="Border"
                        PointerWheelChanged="InputElement_OnPointerWheelChanged">
                        <Border.Transitions>
                            <Transitions>
                                <ThicknessTransition
                                    Duration="0:0:0.1"
                                    Easing="SineEaseOut"
                                    Property="Margin" />
                            </Transitions>
                        </Border.Transitions>
                        <DockPanel>
                            <widgets:InstanceListToolbar
                                DockPanel.Dock="Top"
                                Margin="10"
                                ShowTitleIcon="True" />
                            <Panel>
                                <tio:ScrollView
                                    Background="Transparent"
                                    Classes="Flat"
                                    DockPanel.Dock="Bottom"
                                    Margin="0,2,0,5"
                                    Name="ScrollViewer">
                                    <ItemsRepeater ItemsSource="{Binding FilteredMinecraftInstances}" Margin="12,0,10,7">

                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                ItemsStretch="Fill"
                                                MinColumnSpacing="12"
                                                MinItemHeight="130"
                                                MinItemWidth="270"
                                                MinRowSpacing="12"
                                                Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>

                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate DataType="classes:MinecraftInstance">
                                                <widgets:InstanceCard
                                                    ActionIconSize="15"
                                                    CardHeight="130"
                                                    CardMargin="15,15,15,5"
                                                    ContentFontSize="13"
                                                    FolderMargin="0,6,0,0"
                                                    IconMargin="0,0,10,0"
                                                    IconSize="42"
                                                    LaunchIconSize="16"
                                                    TitleMargin="2,4,0,0"
                                                    TitleWrapping="WrapWithOverflow" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </tio:ScrollView>
                                <Panel
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding !HasFilteredInstances}"
                                    Margin="0,0,0,40"
                                    VerticalAlignment="Center">
                                    <StackPanel
                                        IsVisible="{Binding !HasFilter}"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_5}}" />
                                        <Button Click="AddFolder_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_6}}" />
                                        </Button>
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_7}}" />
                                        <Button Click="ToDownload_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_8}}" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel
                                        IsVisible="{Binding HasFilter}"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_9}}" />
                                        <Button Click="AddFolder_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_6}}" />
                                        </Button>
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_7}}" />
                                        <Button Click="ToDownload_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Translate {x:Static loc:PagesLanguageManager+Keys.newtabpage_8}}" />
                                        </Button>
                                    </StackPanel>
                                </Panel>
                            </Panel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
            <Border IsVisible="{Binding HasRecentPlays}">
                <Border IsVisible="{Binding Data.ConfigEntry.ShowRecentPlays}" Margin="0,8,0,0">
                    <widgets:RecentPlaysSection />
                </Border>
            </Border>
            <Border IsVisible="{Binding Data.ConfigEntry.ShowMinecraftNews}" Margin="0,8,0,0">
                <Border.Styles>
                    <Style Selector="ItemsRepeater#NewsContainer">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Border.Styles>
                <StackPanel IsVisible="{Binding NewsPage.NewsPageViewModel.IsVisible}" Spacing="8">
                    <ContentControl Content="{Binding NewsPage}" Name="NewsContentControl" />
                </StackPanel>
            </Border>
        </StackPanel>
    </tio:ScrollView>
</UserControl>
