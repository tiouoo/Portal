<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.NewTabPage"
    x:DataType="pages:NewTabViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:classes="clr-namespace:Portal.Core.Minecraft.Classes;assembly=Portal.Core"
    xmlns:converters="clr-namespace:Tio.Avalonia.Standard.Modules.Converters;assembly=Tio.Avalonia.Standard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entries="clr-namespace:Portal.Classes.Entries;assembly=Portal"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:portalConverters="clr-namespace:Portal.Module.Converter;assembly=Portal"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:CharacterWrapConverter x:Key="CharWrapConv" />
        <portalConverters:WidthToColumnsConverter x:Key="WidthToColumnsConv" />
        <portalConverters:StringIsNotWriteSpaceOrNullConverter x:Key="StringNotEmptyConv" />
    </UserControl.Resources>
    <tio:ScrollView
        Classes="Flat"
        Margin="12,2,5,10"
        SizeChanged="NewTabPage_OnSizeChanged">
        <StackPanel Margin="0,0,7,0" Spacing="0">
            <DockPanel VerticalAlignment="Top">
                <StackPanel
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Margin="12,0,0,0"
                    Name="StackPanel"
                    Spacing="12"
                    VerticalAlignment="Top">
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="114"
                        Width="260">
                        <Grid>
                            <StackPanel
                                IsVisible="{Binding !HasRecentInstance}"
                                Margin="0,0,0,8"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Data="F1 M640,640z M0,0z M448,128C554,128 640,214 640,320 640,426 554,512 448,512L192,512C86,512 0,426 0,320 0,214 86,128 192,128L448,128z M192,240C178.7,240,168,250.7,168,264L168,296 136,296C122.7,296 112,306.7 112,320 112,333.3 122.7,344 136,344L168,344 168,376C168,389.3 178.7,400 192,400 205.3,400 216,389.3 216,376L216,344 248,344C261.3,344 272,333.3 272,320 272,306.7 261.3,296 248,296L216,296 216,264C216,250.7,205.3,240,192,240z M432,336C414.3,336 400,350.3 400,368 400,385.7 414.3,400 432,400 449.7,400 464,385.7 464,368 464,350.3 449.7,336 432,336z M496,240C478.3,240 464,254.3 464,272 464,289.7 478.3,304 496,304 513.7,304 528,289.7 528,272 528,254.3 513.7,240 496,240z"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Width="30" />
                                <TextBlock
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    HorizontalAlignment="Center"
                                    Text="暂无最近游戏" />
                            </StackPanel>
                            <Panel>
                                <DockPanel
                                    Background="Transparent"
                                    IsVisible="{Binding HasRecentInstance}"
                                    Margin="12,10"
                                    PointerPressed="RecentInstanceCard_OnPointerPressed"
                                    Tag="{Binding RecentInstance}">
                                    <!--  ToolTip.ShowDelay="3000"  -->
                                    <!--  ToolTip.Tip="{Binding RecentInstance.FullInfo}"  -->
                                    <StackPanel
                                        DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Border
                                            ClipToBounds="True"
                                            CornerRadius="12"
                                            Height="42"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,8,0"
                                            Width="42">
                                            <Image
                                                Height="42"
                                                Source="{Binding RecentInstance.Icon}"
                                                Width="42" />
                                        </Border>
                                        <TextBlock
                                            Margin="2,3,0,0"
                                            MaxLines="2"
                                            Text="{Binding RecentInstance.InstanceName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWithOverflow"
                                            VerticalAlignment="Center"
                                            Width="170" />
                                    </StackPanel>
                                    <StackPanel
                                        DockPanel.Dock="Bottom"
                                        Margin="2,1,0,2"
                                        Spacing="2"
                                        VerticalAlignment="Bottom">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Margin="0,4,0,0"
                                            Text="{Binding RecentInstance.FolderName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Text="{Binding RecentInstance.ShortDisplay}" />
                                        <Panel>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                HorizontalAlignment="Left"
                                                Text="{Binding RecentInstance.DisplayLastPlayTime}" />
                                        </Panel>
                                    </StackPanel>
                                </DockPanel>
                                <HyperlinkButton
                                    Click="ContinueGame_Click"
                                    Content="继续游戏"
                                    FontSize="13"
                                    HorizontalAlignment="Right"
                                    IsVisible="{Binding HasRecentInstance}"
                                    Margin="0,0,16,10"
                                    Theme="{StaticResource TransparentHyperlinkButton}"
                                    VerticalAlignment="Bottom" />
                            </Panel>
                        </Grid>
                    </Border>
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="115">
                        <Grid>
                            <StackPanel
                                IsVisible="{Binding !HasRecentPlayTargetItem}"
                                Margin="0,0,0,8"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <PathIcon
                                    Data="F1 M640,640z M0,0z M480,96C515.3,96,544,124.7,544,160L544,480C544,515.3,515.3,544,480,544L160,544C124.7,544,96,515.3,96,480L96,160C96,124.7,124.7,96,160,96L480,96z M368,360C368,373.3 378.7,384 392,384 405.3,384 416,373.3 416,360L416,248C416,234.7,405.3,224,392,224L280,224C266.7,224,256,234.7,256,248 256,261.3 266.7,272 280,272L334.1,272 231.1,375C221.7,384.4 221.7,399.6 231.1,408.9 240.5,418.2 255.7,418.3 265,408.9L368,305.9 368,360z"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Width="30" />
                                <TextBlock
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    HorizontalAlignment="Center"
                                    Text="暂无最近存档或服务器" />
                            </StackPanel>
                            <Panel>
                                <DockPanel
                                    Background="Transparent"
                                    IsVisible="{Binding HasRecentPlayTargetItem}"
                                    Margin="12,10"
                                    PointerPressed="RecentPlayTargetCard_OnPointerPressed"
                                    Tag="{Binding RecentPlayTargetItem.Target}">
                                    <DockPanel DockPanel.Dock="Top">
                                        <Border
                                            ClipToBounds="True"
                                            CornerRadius="10"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            Width="40">
                                            <Image
                                                Height="40"
                                                Source="{Binding RecentPlayTargetItem.Icon}"
                                                Width="40" />
                                        </Border>
                                        <StackPanel Margin="2,3,0,0" Spacing="2">
                                            <TextBlock
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                IsVisible="{Binding RecentPlayTargetItem.HasFolderName}"
                                                MaxLines="1"
                                                Text="{Binding RecentPlayTargetItem.FolderName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel
                                        DockPanel.Dock="Bottom"
                                        Margin="2,6,0,4"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding RecentPlayTargetItem.InstanceName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            MaxLines="1"
                                            Text="{Binding RecentPlayTargetItem.Details}"
                                            TextTrimming="CharacterEllipsis" />
                                        <DockPanel>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Text="{Binding RecentPlayTargetItem.RelativeTime}" />
                                            <HyperlinkButton
                                                Click="ContinueTargetGame_Click"
                                                Content="继续游戏"
                                                DockPanel.Dock="Right"
                                                FontSize="13"
                                                HorizontalAlignment="Right"
                                                IsVisible="{Binding RecentPlayTargetItem.CanQuickPlay}"
                                                Tag="{Binding RecentPlayTargetItem.Target}"
                                                Theme="{StaticResource TransparentHyperlinkButton}" />
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Panel>
                        </Grid>
                    </Border>
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Height="87">
                        <StackPanel Margin="13,13,0,10">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Top">
                                <PathIcon
                                    Data="F1 M640,640z M0,0z M320,64C461.4,64 576,178.6 576,320 576,461.4 461.4,576 320,576 178.6,576 64,461.4 64,320 64,178.6 178.6,64 320,64z M296,184L296,320C296,328,300,335.5,306.7,340L402.7,404C413.7,411.4 428.6,408.4 436,397.3 443.4,386.2 440.4,371.4 429.3,364L344,307.2 344,184C344,170.7 333.3,160 320,160 306.7,160 296,170.7 296,184z"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Height="20"
                                    Width="20" />
                                <TextBlock
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Text="游戏时长"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel
                                Margin="3,10,0,0"
                                Orientation="Horizontal"
                                Spacing="7">
                                <TextBlock VerticalAlignment="Center">
                                    <Run FontSize="28" Text="{Binding DisplayTotalPlayTime}" />
                                    <Run
                                        FontSize="18"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Text="{Binding PlayTimeUnit}" />
                                </TextBlock>
                                <Rectangle
                                    Fill="{DynamicResource TranslucentBorderBrush}"
                                    Margin="0,3"
                                    Width="1" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run FontSize="28" Text="{Binding DisplayTotalPlaySessions}" />
                                    <Run
                                        FontSize="14"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Text="次会话" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition
                                Duration="0:0:0.1"
                                Easing="SineEaseOut"
                                Property="Opacity" />
                        </Transitions>
                    </StackPanel.Transitions>
                </StackPanel>
                <StackPanel Spacing="12">
                    <Border
                        Background="{DynamicResource TranslucentBackgroundColor}"
                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="16"
                        Height="340"
                        Name="Border"
                        PointerWheelChanged="InputElement_OnPointerWheelChanged">
                        <Border.Transitions>
                            <Transitions>
                                <ThicknessTransition
                                    Duration="0:0:0.1"
                                    Easing="SineEaseOut"
                                    Property="Margin" />
                            </Transitions>
                        </Border.Transitions>
                        <DockPanel>
                            <Panel DockPanel.Dock="Top" Margin="10">
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    Margin="13,3,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                    <Button
                                        Background="Transparent"
                                        Click="ButtonOpenInstance_OnClick"
                                        Theme="{StaticResource TransparentButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M480,576L192,576C139,576,96,533,96,480L96,160C96,107,139,64,192,64L496,64C522.5,64,544,85.5,544,112L544,400C544,420.9,530.6,438.7,512,445.3L512,512C529.7,512 544,526.3 544,544 544,561.7 529.7,576 512,576L480,576z M192,448C174.3,448 160,462.3 160,480 160,497.7 174.3,512 192,512L448,512 448,448 192,448z M224,216C224,229.3,234.7,240,248,240L424,240C437.3,240 448,229.3 448,216 448,202.7 437.3,192 424,192L248,192C234.7,192,224,202.7,224,216z M248,288C234.7,288 224,298.7 224,312 224,325.3 234.7,336 248,336L424,336C437.3,336 448,325.3 448,312 448,298.7 437.3,288 424,288L248,288z"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Height="21"
                                                Margin="0,-1,0,0"
                                                Width="21" />
                                            <TextBlock
                                                FontSize="15"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Margin="5,0,0,0"
                                                Text="实例"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Click="RefreshInstance_Click"
                                        Margin="5,0,0,0"
                                        Theme="{StaticResource TransparentButton}"
                                        VerticalAlignment="Center">
                                        <PathIcon
                                            Data="F1 M640,640z M0,0z M500.7,138.7L512,149.4 512,96C512,78.3 526.3,64 544,64 561.7,64 576,78.3 576,96L576,224C576,241.7,561.7,256,544,256L416,256C398.3,256 384,241.7 384,224 384,206.3 398.3,192 416,192L463.9,192 456.3,184.8C456.1,184.6 455.9,184.4 455.7,184.2 380.7,109.2 259.2,109.2 184.2,184.2 109.2,259.2 109.2,380.7 184.2,455.7 259.2,530.7 380.7,530.7 455.7,455.7 463.9,447.5 471.2,438.8 477.6,429.6 487.7,415.1 507.7,411.6 522.2,421.7 536.7,431.8 540.2,451.8 530.1,466.3 521.6,478.5 511.9,490.1 501,501 401,601 238.9,601 139,501 39.1,401 39,239 139,139 238.9,39.1 400.7,39 500.7,138.7z"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Height="16"
                                            Width="16" />
                                    </Button>
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Command="{Binding ToggleBlockedInstancesCommand}"
                                        IsVisible="{Binding HasBlockedInstancesOnly}"
                                        VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource ForegroundColor}" Text="{Binding ToggleBlockedInstancesText}" />
                                    </Button>
                                    <DropDownButton Content="添加" Foreground="{DynamicResource ForegroundColor}">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Click="ImportModpack_Click" Header="导入整合包">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="F1 M640,640z M0,0z M560.3,301.2C570.7,313 588.6,315.6 602.1,306.7 616.8,296.9 620.8,277 611,262.3L563,190.3C560.2,186.1,556.4,182.6,551.9,180.1L351.4,68.7C332.1,58,308.6,58,289.2,68.7L88.8,180C83.4,183,79.1,187.4,76.2,192.8L27.7,282.7C15.1,306.1,23.9,335.2,47.3,347.8L80.3,365.5 80.3,418.8C80.3,441.8,92.7,463.1,112.7,474.5L288.7,574.2C308.3,585.3,332.2,585.3,351.8,574.2L527.8,474.5C547.9,463.1,560.2,441.9,560.2,418.8L560.2,301.3z M320.3,291.4L170.2,208 320.3,124.6 470.4,208 320.3,291.4z M278.8,341.6L257.5,387.8 91.7,299 117.1,251.8 278.8,341.6z" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Click="AddFolder_Click" Header="添加文件夹">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="F1 M640,640z M0,0z M544,269.8C529.2,279.6 512.2,287.5 494.5,293.8 447.5,310.6 385.8,320 320,320 254.2,320 192.4,310.5 145.5,293.8 127.9,287.5 110.8,279.6 96,269.8L96,352C96,396.2 196.3,432 320,432 443.7,432 544,396.2 544,352L544,269.8z M544,192L544,144C544,99.8 443.7,64 320,64 196.3,64 96,99.8 96,144L96,192C96,236.2 196.3,272 320,272 443.7,272 544,236.2 544,192z M494.5,453.8C447.6,470.5 385.9,480 320,480 254.1,480 192.4,470.5 145.5,453.8 127.9,447.5 110.8,439.6 96,429.8L96,496C96,540.2 196.3,576 320,576 443.7,576 544,540.2 544,496L544,429.8C529.2,439.6,512.2,447.5,494.5,453.8z" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Click="ToDownload_Click" Header="创建新实例">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="F1 M640,640z M0,0z M352,96C352,78.3 337.7,64 320,64 302.3,64 288,78.3 288,96L288,306.7 246.6,265.3C234.1,252.8 213.8,252.8 201.3,265.3 188.8,277.8 188.8,298.1 201.3,310.6L297.3,406.6C309.8,419.1,330.1,419.1,342.6,406.6L438.6,310.6C451.1,298.1 451.1,277.8 438.6,265.3 426.1,252.8 405.8,252.8 393.3,265.3L352,306.7 352,96z M160,384C124.7,384,96,412.7,96,448L96,480C96,515.3,124.7,544,160,544L480,544C515.3,544,544,515.3,544,480L544,448C544,412.7,515.3,384,480,384L433.1,384 376.5,440.6C345.3,471.8,294.6,471.8,263.4,440.6L206.9,384 160,384z M464,440C477.3,440 488,450.7 488,464 488,477.3 477.3,488 464,488 450.7,488 440,477.3 440,464 440,450.7 450.7,440 464,440z" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <ComboBox
                                        ItemsSource="{Binding SortOptions}"
                                        SelectedItem="{Binding SelectedSortOption}"
                                        Width="120">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox
                                        PlaceholderText="搜索"
                                        Text="{Binding SearchText}"
                                        Width="170">
                                        <TextBox.InnerRightContent>
                                            <PathIcon
                                                Data="F1 M512,512z M0,0z M416,208C416,253.9,401.1,296.3,376,330.7L502.6,457.4C515.1,469.9 515.1,490.2 502.6,502.7 490.1,515.2 469.8,515.2 457.3,502.7L330.7,376C296.3,401.1 253.9,416 208,416 93.1,416 0,322.9 0,208 0,93.1 93.1,0 208,0 322.9,0 416,93.1 416,208z M208,352A144,144,0,1,0,208,64A144,144,0,1,0,208,352z"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Height="14"
                                                Width="14" />
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                </StackPanel>
                            </Panel>
                            <Panel>
                                <tio:ScrollView
                                    Background="Transparent"
                                    Classes="Flat"
                                    DockPanel.Dock="Bottom"
                                    Margin="0,2,0,5"
                                    Name="ScrollViewer">
                                    <ItemsRepeater ItemsSource="{Binding FilteredMinecraftInstances}" Margin="12,0,10,7">

                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                ItemsStretch="Fill"
                                                MinColumnSpacing="12"
                                                MinItemHeight="130"
                                                MinItemWidth="270"
                                                MinRowSpacing="12"
                                                Orientation="Horizontal" />
                                        </ItemsRepeater.Layout>

                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate DataType="classes:MinecraftInstance">
                                                <Border
                                                    Background="{DynamicResource TranslucentBackgroundColor}"
                                                    BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Height="130"
                                                    Margin="0,0,0,0"
                                                    Name="InstanceCard"
                                                    PointerPressed="InstanceCard_OnPointerPressed">

                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem
                                                                Click="LaunchInstance_Click"
                                                                Header="游玩"
                                                                Tag="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon
                                                                        Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                                        Height="16"
                                                                        Width="16" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem
                                                                Click="CreateShortcut_Click"
                                                                Header="快捷方式"
                                                                Tag="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon
                                                                        Data="F1 M640,640z M0,0z M434.8,54.1C446.7,62.7,451.1,78.3,445.7,91.9L367.3,288 512,288C525.5,288 537.5,296.4 542.1,309.1 546.7,321.8 542.8,336 532.5,344.6L244.5,584.6C233.2,594 217.1,594.5 205.2,585.9 193.3,577.3 188.9,561.7 194.3,548.1L272.7,352 128,352C114.5,352 102.5,343.6 97.9,330.9 93.3,318.2 97.2,304 107.5,295.4L395.5,55.4C406.8,46,422.9,45.5,434.8,54.1z"
                                                                        Height="16"
                                                                        Width="16" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem
                                                                Click="FavoritedButton_OnClick"
                                                                Header="{Binding FavoriteHeaderText}"
                                                                Tag="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon
                                                                        Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                        Height="16"
                                                                        Width="16" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem
                                                                Click="BlockInstance_Click"
                                                                Header="{Binding BlockHeaderText}"
                                                                Tag="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <PathIcon
                                                                        Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M231,231C240.4,221.6,255.6,221.6,264.9,231L319.9,286 374.9,231C384.3,221.6 399.5,221.6 408.8,231 418.1,240.4 418.2,255.6 408.8,264.9L353.8,319.9 408.8,374.9C418.2,384.3 418.2,399.5 408.8,408.8 399.4,418.1 384.2,418.2 374.9,408.8L319.9,353.8 264.9,408.8C255.5,418.2 240.3,418.2 231,408.8 221.7,399.4 221.6,384.2 231,374.9L286,319.9 231,264.9C221.6,255.5,221.6,240.3,231,231z"
                                                                        Height="16"
                                                                        Width="16" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Border.Styles>
                                                        <Style Selector="Border#InstanceCard">
                                                            <Style Selector="^ Button#LaunchButton">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </Style>
                                                            <Style Selector="^ Button#UnfavoritedButton PathIcon">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </Style>
                                                            <Style Selector="^ Button#UnfavoritedButton PathIcon#SolidStar">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </Style>
                                                            <Style Selector="^ Button#UnfavoritedButton">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </Style>
                                                        </Style>
                                                        <Style Selector="Border#InstanceCard:pointerover">
                                                            <Style Selector="^ Button#LaunchButton">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </Style>
                                                            <Style Selector="^ Button#UnfavoritedButton">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </Style>
                                                        </Style>
                                                    </Border.Styles>

                                                    <DockPanel Margin="15,15,15,5">
                                                        <DockPanel DockPanel.Dock="Top">
                                                            <Border
                                                                ClipToBounds="True"
                                                                CornerRadius="10"
                                                                DockPanel.Dock="Left"
                                                                Height="42"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,0,10,0"
                                                                Width="42">
                                                                <Image
                                                                    Height="42"
                                                                    Source="{Binding Icon}"
                                                                    Width="42" />
                                                            </Border>
                                                            <TextBlock
                                                                Margin="2,4,0,0"
                                                                MaxLines="2"
                                                                Text="{Binding InstanceName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="WrapWithOverflow" />
                                                        </DockPanel>

                                                        <StackPanel
                                                            DockPanel.Dock="Bottom"
                                                            Margin="0,0,0,5"
                                                            Spacing="2"
                                                            VerticalAlignment="Bottom">
                                                            <TextBlock
                                                                FontSize="13"
                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                Margin="0,6,0,0"
                                                                Text="{Binding FolderName}" />
                                                            <TextBlock
                                                                FontSize="13"
                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                Text="{Binding ShortDisplay}" />
                                                            <DockPanel>
                                                                <TextBlock
                                                                    DockPanel.Dock="Left"
                                                                    FontSize="13"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Text="{Binding DisplayLastPlayTime}" />
                                                                <StackPanel
                                                                    DockPanel.Dock="Right"
                                                                    HorizontalAlignment="Right"
                                                                    Orientation="Horizontal">

                                                                    <Button
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="LaunchInstance_Click"
                                                                        Cursor="Hand"
                                                                        Padding="4,-2,2,0"
                                                                        Tag="{Binding}"
                                                                        Theme="{StaticResource TransparentButton}"
                                                                        ToolTip.Tip="启动实例"
                                                                        x:Name="LaunchButton">
                                                                        <PathIcon
                                                                            Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                                            Foreground="{DynamicResource InnerForegroundColor}"
                                                                            Height="16"
                                                                            Width="16" />
                                                                        <Button.Transitions>
                                                                            <Transitions>
                                                                                <DoubleTransition
                                                                                    Duration="0:0:0.15"
                                                                                    Easing="SineEaseOut"
                                                                                    Property="Opacity" />
                                                                            </Transitions>
                                                                        </Button.Transitions>
                                                                    </Button>

                                                                    <Button
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="FavoritedButton_OnClick"
                                                                        Cursor="Hand"
                                                                        IsVisible="{Binding !Config.IsFavorite}"
                                                                        Padding="4,0,4,0"
                                                                        Tag="{Binding}"
                                                                        Theme="{StaticResource TransparentButton}"
                                                                        x:Name="UnfavoritedButton">
                                                                        <Grid>
                                                                            <PathIcon
                                                                                Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                                Height="15"
                                                                                Width="15"
                                                                                x:Name="SolidStar" />
                                                                            <PathIcon
                                                                                Data="F1 M640,640z M0,0z M320.1,32C329.1,32,337.4,37.1,341.5,45.1L415,189.3 574.9,214.7C583.8,216.1 591.2,222.4 594,231 596.8,239.6 594.5,249 588.2,255.4L473.7,369.9 499,529.8C500.4,538.7 496.7,547.7 489.4,553 482.1,558.3 472.4,559.1 464.4,555L320.1,481.6 175.8,555C167.8,559.1 158.1,558.3 150.8,553 143.5,547.7 139.8,538.8 141.2,529.8L166.4,369.9 52,255.4C45.6,249 43.4,239.6 46.2,231 49,222.4 56.3,216.1 65.3,214.7L225.2,189.3 298.8,45.1C302.9,37.1,311.2,32,320.2,32z M320.1,108.8L262.3,222C258.8,228.8,252.3,233.6,244.7,234.8L119.2,254.8 209,344.7C214.4,350.1,216.9,357.8,215.7,365.4L195.9,490.9 309.2,433.3C316,429.8,324.1,429.8,331,433.3L444.3,490.9 424.5,365.4C423.3,357.8,425.8,350.1,431.2,344.7L521,254.8 395.5,234.8C387.9,233.6,381.4,228.8,377.9,222L320.1,108.8z"
                                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                                Height="15"
                                                                                Width="15" />
                                                                        </Grid>
                                                                        <Button.Transitions>
                                                                            <Transitions>
                                                                                <DoubleTransition
                                                                                    Duration="0:0:0.15"
                                                                                    Easing="SineEaseOut"
                                                                                    Property="Opacity" />
                                                                            </Transitions>
                                                                        </Button.Transitions>
                                                                    </Button>

                                                                    <Button
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="FavoritedButton_OnClick"
                                                                        Cursor="Hand"
                                                                        IsVisible="{Binding Config.IsFavorite}"
                                                                        Padding="4,0,4,0"
                                                                        Tag="{Binding}"
                                                                        Theme="{StaticResource TransparentButton}"
                                                                        x:Name="FavoritedButton">
                                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                                            <PathIcon
                                                                                Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                                Height="15"
                                                                                Width="15" />
                                                                            <TextBlock
                                                                                FontSize="13"
                                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                                Text="已收藏" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="BlockInstance_Click"
                                                                        Cursor="Hand"
                                                                        IsVisible="{Binding IsBlocked}"
                                                                        Padding="4,0,4,0"
                                                                        Tag="{Binding}"
                                                                        Theme="{StaticResource TransparentButton}"
                                                                        x:Name="BlockedButton">
                                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                                            <PathIcon
                                                                                Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M231,231C240.4,221.6,255.6,221.6,264.9,231L319.9,286 374.9,231C384.3,221.6 399.5,221.6 408.8,231 418.1,240.4 418.2,255.6 408.8,264.9L353.8,319.9 408.8,374.9C418.2,384.3 418.2,399.5 408.8,408.8 399.4,418.1 384.2,418.2 374.9,408.8L319.9,353.8 264.9,408.8C255.5,418.2 240.3,418.2 231,408.8 221.7,399.4 221.6,384.2 231,374.9L286,319.9 231,264.9C221.6,255.5,221.6,240.3,231,231z"
                                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                                Height="15"
                                                                                Width="15" />
                                                                            <TextBlock
                                                                                FontSize="13"
                                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                                Text="已屏蔽" />
                                                                        </StackPanel>
                                                                    </Button>

                                                                </StackPanel>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </tio:ScrollView>
                                <Panel
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding !HasFilteredInstances}"
                                    Margin="0,0,0,40"
                                    VerticalAlignment="Center">
                                    <StackPanel
                                        IsVisible="{Binding !HasFilter}"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="暂无实例，请前往" />
                                        <Button Click="AddFolder_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="添加文件夹" />
                                        </Button>
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="或" />
                                        <Button Click="ToDownload_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="创建新实例" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel
                                        IsVisible="{Binding HasFilter}"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="暂无匹配实例，请修改筛选条件，前往" />
                                        <Button Click="AddFolder_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="添加文件夹" />
                                        </Button>
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="或" />
                                        <Button Click="ToDownload_Click" Theme="{StaticResource TransparentButton}">
                                            <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="创建新实例" />
                                        </Button>
                                    </StackPanel>
                                </Panel>
                            </Panel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
            <Border IsVisible="{Binding HasRecentPlays}">
                <Border IsVisible="{Binding Data.ConfigEntry.ShowRecentPlays}" Margin="0,8,0,0">
                    <StackPanel IsVisible="{Binding HasRecentPlays}" Spacing="8">
                        <DockPanel Margin="15,0,0,0">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="15"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Text="最近游玩" />
                                <Button Click="RefreshRecentPlays_Click" Theme="{StaticResource TransparentButton}">
                                    <PathIcon
                                        Data="F1 M640,640z M0,0z M500.7,138.7L512,149.4 512,96C512,78.3 526.3,64 544,64 561.7,64 576,78.3 576,96L576,224C576,241.7,561.7,256,544,256L416,256C398.3,256 384,241.7 384,224 384,206.3 398.3,192 416,192L463.9,192 456.3,184.8C456.1,184.6 455.9,184.4 455.7,184.2 380.7,109.2 259.2,109.2 184.2,184.2 109.2,259.2 109.2,380.7 184.2,455.7 259.2,530.7 380.7,530.7 455.7,455.7 463.9,447.5 471.2,438.8 477.6,429.6 487.7,415.1 507.7,411.6 522.2,421.7 536.7,431.8 540.2,451.8 530.1,466.3 521.6,478.5 511.9,490.1 501,501 401,601 238.9,601 139,501 39.1,401 39,239 139,139 238.9,39.1 400.7,39 500.7,138.7z"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Height="16"
                                        Width="16" />
                                </Button>
                            </StackPanel>
                            <Button
                                Command="{Binding ToggleRecentPlaysCommand}"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding CanExpandRecentPlays}"
                                Margin="0,0,10,0"
                                Theme="{StaticResource TransparentButton}"
                                VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Binding ToggleRecentPlaysText}" />
                            </Button>
                            <Button
                                Command="{Binding ToggleBlockedRecentPlaysCommand}"
                                DockPanel.Dock="Right"
                                FontSize="13"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding HasBlockedRecentPlaysOnly}"
                                Margin="0,0,8,0"
                                Theme="{StaticResource TransparentButton}"
                                VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource SystemAccentColor}" Text="{Binding ToggleBlockedRecentPlaysText}" />
                            </Button>
                        </DockPanel>
                        <ItemsRepeater HorizontalAlignment="Stretch" ItemsSource="{Binding RecentPlays}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemWidth="270"
                                    MinRowSpacing="12"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate DataType="pages:RecentPlayItem">
                                    <Border
                                        Background="{DynamicResource TranslucentBackgroundColor}"
                                        BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Height="120"
                                        Name="RecentBorder"
                                        PointerPressed="RecentPlayItem_OnPointerPressed">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Click="QuickPlay_Click"
                                                    Header="游玩"
                                                    Tag="{Binding Target}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Click="RecentPlayCreateShortcut_Click"
                                                    Header="快捷方式"
                                                    Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M434.8,54.1C446.7,62.7,451.1,78.3,445.7,91.9L367.3,288 512,288C525.5,288 537.5,296.4 542.1,309.1 546.7,321.8 542.8,336 532.5,344.6L244.5,584.6C233.2,594 217.1,594.5 205.2,585.9 193.3,577.3 188.9,561.7 194.3,548.1L272.7,352 128,352C114.5,352 102.5,343.6 97.9,330.9 93.3,318.2 97.2,304 107.5,295.4L395.5,55.4C406.8,46,422.9,45.5,434.8,54.1z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Click="RecentPlayFavorite_Click"
                                                    Header="{Binding FavoriteHeaderText}"
                                                    Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Click="BlockRecentPlay_Click"
                                                    Header="{Binding BlockHeaderText}"
                                                    Tag="{Binding Target}">
                                                    <MenuItem.Icon>
                                                        <PathIcon
                                                            Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M231,231C240.4,221.6,255.6,221.6,264.9,231L319.9,286 374.9,231C384.3,221.6 399.5,221.6 408.8,231 418.1,240.4 418.2,255.6 408.8,264.9L353.8,319.9 408.8,374.9C418.2,384.3 418.2,399.5 408.8,408.8 399.4,418.1 384.2,418.2 374.9,408.8L319.9,353.8 264.9,408.8C255.5,418.2 240.3,418.2 231,408.8 221.7,399.4 221.6,384.2 231,374.9L286,319.9 231,264.9C221.6,255.5,221.6,240.3,231,231z"
                                                            Height="16"
                                                            Width="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Styles>
                                            <Style Selector="Button#QuickPlayButton">
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                            <Style Selector="Button#UnfavoritedRecentPlayButton PathIcon">
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                            <Style Selector="Button#UnfavoritedRecentPlayButton PathIcon#SolidStar">
                                                <Setter Property="Opacity" Value="1" />
                                            </Style>
                                            <Style Selector="Button#UnfavoritedRecentPlayButton">
                                                <Setter Property="Opacity" Value="0" />
                                            </Style>
                                            <Style Selector="Border#RecentBorder:pointerover Button#QuickPlayButton, Border#RecentBorder:pointerover Button#UnfavoritedRecentPlayButton">
                                                <Setter Property="Opacity" Value="1" />
                                            </Style>
                                        </Border.Styles>
                                        <DockPanel Margin="12,12,12,5">
                                            <DockPanel DockPanel.Dock="Top">
                                                <Border
                                                    ClipToBounds="True"
                                                    CornerRadius="10"
                                                    Height="40"
                                                    Margin="0,0,8,0"
                                                    Width="40">
                                                    <Image
                                                        Height="40"
                                                        Source="{Binding Icon}"
                                                        Width="40" />
                                                </Border>
                                                <StackPanel Margin="2,3,0,0" Spacing="2">
                                                    <TextBlock
                                                        MaxLines="1"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource InnerForegroundColor}"
                                                        IsVisible="{Binding HasFolderName}"
                                                        MaxLines="1"
                                                        Text="{Binding FolderName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel
                                                DockPanel.Dock="Bottom"
                                                Margin="2,8,0,5"
                                                Spacing="2">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    MaxLines="1"
                                                    Text="{Binding InstanceName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    MaxLines="1"
                                                    Text="{Binding Details}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <DockPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource InnerForegroundColor}"
                                                        Text="{Binding RelativeTime}" />
                                                    <StackPanel
                                                        DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="QuickPlay_Click"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,0,2,2"
                                                            Padding="4,-2,2,0"
                                                            Tag="{Binding Target}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            ToolTip.Tip="快速进入"
                                                            x:Name="QuickPlayButton">
                                                            <PathIcon
                                                                Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                                Height="15"
                                                                Width="15" />
                                                            <Button.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition
                                                                        Duration="0:0:0.15"
                                                                        Easing="SineEaseOut"
                                                                        Property="Opacity" />
                                                                </Transitions>
                                                            </Button.Transitions>
                                                        </Button>
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="RecentPlayFavorite_Click"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding !IsFavorite}"
                                                            Padding="4,-4,4,0"
                                                            Tag="{Binding}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            x:Name="UnfavoritedRecentPlayButton">
                                                            <Grid>
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    Width="15"
                                                                    x:Name="SolidStar" />
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M320.1,32C329.1,32 337.4,37.1 341.5,45.1L415,189.3 574.9,214.7C583.8,216.1 591.2,222.4 594,231 596.8,239.6 594.5,249 588.2,255.4L473.7,369.9 499,529.8C500.4,538.7 496.7,547.7 489.4,553 482.1,558.3 472.4,559.1 464.4,555L320.1,481.6 175.8,555C167.8,559.1 158.1,558.3 150.8,553 143.5,547.7 139.8,538.8 141.2,529.8L166.4,369.9 52,255.4C45.6,249 43.4,239.6 46.2,231 49,222.4 56.3,216.1 65.3,214.7L225.2,189.3 298.8,45.1C302.9,37.1 311.2,32 320.2,32z M320.1,108.8L262.3,222C258.8,228.8 252.3,233.6 244.7,234.8L119.2,254.8 209,344.7C214.4,350.1 216.9,357.8 215.7,365.4L195.9,490.9 309.2,433.3C316,429.8 324.1,429.8 331,433.3L444.3,490.9 424.5,365.4C423.3,357.8 425.8,350.1 431.2,344.7L521,254.8 395.5,234.8C387.9,233.6 381.4,228.8 377.9,222L320.1,108.8z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    Width="15" />
                                                            </Grid>
                                                            <Button.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition
                                                                        Duration="0:0:0.15"
                                                                        Easing="SineEaseOut"
                                                                        Property="Opacity" />
                                                                </Transitions>
                                                            </Button.Transitions>
                                                        </Button>
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="RecentPlayFavorite_Click"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding IsFavorite}"
                                                            Padding="4,-4,4,0"
                                                            Tag="{Binding}"
                                                            Theme="{StaticResource TransparentButton}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M341.5,45.1C337.4,37.1 329.1,32 320.1,32 311.1,32 302.8,37.1 298.7,45.1L225.1,189.3 65.2,214.7C56.3,216.1 48.9,222.4 46.1,231 43.3,239.6 45.6,249 51.9,255.4L166.3,369.9 141.1,529.8C139.7,538.7 143.4,547.7 150.7,553 158,558.3 167.6,559.1 175.7,555L320.1,481.6 464.4,555C472.4,559.1 482.1,558.3 489.4,553 496.7,547.7 500.4,538.8 499,529.8L473.7,369.9 588.1,255.4C594.5,249 596.7,239.6 593.9,231 591.1,222.4 583.8,216.1 574.8,214.7L415,189.3 341.5,45.1z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    VerticalAlignment="Center"
                                                                    Width="15" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Text="已收藏"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="BlockRecentPlay_Click"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding IsBlocked}"
                                                            Margin="0,-4,0,0"
                                                            Padding="4,0,4,0"
                                                            Tag="{Binding Target}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            x:Name="BlockedRecentPlayButton">
                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                <PathIcon
                                                                    Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M231,231C240.4,221.6,255.6,221.6,264.9,231L319.9,286 374.9,231C384.3,221.6 399.5,221.6 408.8,231 418.1,240.4 418.2,255.6 408.8,264.9L353.8,319.9 408.8,374.9C418.2,384.3 418.2,399.5 408.8,408.8 399.4,418.1 384.2,418.2 374.9,408.8L319.9,353.8 264.9,408.8C255.5,418.2 240.3,418.2 231,408.8 221.7,399.4 221.6,384.2 231,374.9L286,319.9 231,264.9C221.6,255.5,221.6,240.3,231,231z"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    Height="15"
                                                                    Width="15" />
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                                    MaxLines="1"
                                                                    Text="已屏蔽"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Border>
            <Border IsVisible="{Binding Data.ConfigEntry.ShowMinecraftNews}" Margin="0,8,0,0">
                <Border.Styles>
                    <Style Selector="ItemsRepeater#NewsContainer">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Border.Styles>
                <StackPanel IsVisible="{Binding NewsPage.NewsPageViewModel.IsVisible}" Spacing="8">
                    <ContentControl Content="{Binding NewsPage}" Name="NewsContentControl" />
                </StackPanel>
            </Border>
        </StackPanel>
    </tio:ScrollView>
</UserControl>
