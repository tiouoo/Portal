<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.ToolsPage"
    x:DataType="pages:ToolsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:toolsPages="clr-namespace:Portal.Views.Pages.ToolsPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <DockPanel>
        <controls:ScrollView
            Classes="Flat"
            DockPanel.Dock="Left"
            HorizontalAlignment="Left"
            Margin="7,0,10,10"
            Width="150">
            <tio:NavMenu Margin="0,0,10,0" Theme="{StaticResource FlatScrollBarTheme}">
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type toolsPages:BedrockToolsPage}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.toolspage_BedrockEdition}}"
                    IsSelected="True"
                    IsVisible="{Binding IsWindows}">
                    <tio:NavMenuItem.Icon>
                        <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe60f;" FontSize="16" />
                    </tio:NavMenuItem.Icon>
                </tio:NavMenuItem>
            </tio:NavMenu>
        </controls:ScrollView>

        <TransitioningContentControl Content="{Binding CurrentPage}" Margin="0,10,10,10">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </DockPanel>
</UserControl>