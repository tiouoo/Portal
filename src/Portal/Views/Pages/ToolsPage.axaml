<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.ToolsPage"
    x:DataType="pages:ToolsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Portal.Views.Pages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:toolsPages="clr-namespace:Portal.Views.Pages.ToolsPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <DockPanel>
        <controls:ScrollView
            Classes="Flat"
            DockPanel.Dock="Left"
            HorizontalAlignment="Left"
            Margin="7,0,10,10"
            Width="150">
            <tio:NavMenu Margin="0,0,10,0" Theme="{StaticResource FlatScrollBarTheme}">
                <tio:NavMenuItem
                    Command="{Binding NavigateTypeCommand}"
                    CommandParameter="{x:Type toolsPages:BedrockToolsPage}"
                    Header="{Translate {x:Static loc:PagesLanguageManager+Keys.toolspage_BedrockEdition}}"
                    IsSelected="True"
                    IsVisible="{Binding IsWindows}">
                    <tio:NavMenuItem.Icon>
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="16"
                            Margin="-1,-1,0,-1"
                            Padding="1,0"
                            Text="&#xe670;" />
                    </tio:NavMenuItem.Icon>
                </tio:NavMenuItem>
            </tio:NavMenu>
        </controls:ScrollView>

        <Grid RowDefinitions="Auto,*">
            <StackPanel
                HorizontalAlignment="Stretch"
                Margin="20,15,30,20"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    FontFamily="{StaticResource IconFont}"
                    FontSize="22"
                    HorizontalAlignment="Center"
                    Text="&#xe670;"
                    VerticalAlignment="Center"
                    Width="26" />
                <TextBlock
                    FontSize="26"
                    FontWeight="Thin"
                    Text="{Translate {x:Static loc:PagesLanguageManager+Keys.toolspage_BedrockEdition}}"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TransitioningContentControl Content="{Binding CurrentPage}" Grid.Row="1" Margin="10,0,10,10">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.2" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </DockPanel>
</UserControl>
