<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.ServerEditDialog"
    x:DataType="instancePages:ServerEditDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Margin="24"
        RowDefinitions="Auto, *, Auto"
        Width="510">
        <TextBlock
            FontSize="16"
            FontWeight="600"
            Grid.Row="0"
            Text="{Binding Title}" />
        <tio:Form
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            LabelPosition="Top"
            Margin="0,10,0,15">
            <tio:FormItem Label="服务器名称">
                <DataValidationErrors>
                    <TextBox
                        PlaceholderText="例如：我的世界生存服"
                        Text="{Binding Name}"
                        tio:FocusHelper.DialogFocusHint="True" />
                </DataValidationErrors>
            </tio:FormItem>
            <tio:FormItem Label="服务器地址">
                <StackPanel Spacing="4">
                    <DataValidationErrors>
                        <TextBox PlaceholderText="{Binding AddressPlaceholder}" Text="{Binding Address}" />
                    </DataValidationErrors>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="{Binding PortHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </tio:FormItem>
        </tio:Form>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding CancelCommand}" Content="取消" />
            <Button Command="{Binding ConfirmCommand}" Content="确定" />
        </StackPanel>
    </Grid>
</UserControl>