<UserControl
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.BedrockServers"
    x:DataType="instancePages:BedrockServers"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="clr-namespace:SmoothScroll.Avalonia.Controls;assembly=SmoothScroll.Avalonia.Controls"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <Button
                Click="AddServer_OnClick"
                Content="添加服务器"
                DockPanel.Dock="Right"
                VerticalAlignment="Top" />
            <Button
                Click="RefreshAll_OnClick"
                Content="刷新"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top" />
            <Button
                Click="OpenFolder_OnClick"
                Content="打开文件夹"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top" />
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                PlaceholderText="搜索服务器"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180" />
            <ComboBox
                DisplayMemberBinding="{Binding}"
                DockPanel.Dock="Right"
                ItemsSource="{Binding UserIds}"
                Margin="0,0,8,0"
                MinWidth="180"
                Name="UserIdSelector"
                SelectionChanged="UserIdSelector_OnSelectionChanged"
                ToolTip.Tip="选择基岩版数据用户 ID"
                VerticalAlignment="Top" />
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    FontSize="24"
                    MaxLines="1"
                    Text="服务器"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    MaxLines="1"
                    Text="{Binding CountText}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    IsVisible="{Binding IsRefreshing}"
                    Margin="0,8,0,0"
                    Text="·正在检测服务器状态"
                    TextWrapping="NoWrap" />
            </DockPanel>
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsLoading}"
                Margin="0,8,0,0"
                Text="正在读取服务器..." />
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsEmpty}"
                Margin="0,8,0,0"
                Text="所选用户 ID 下没有服务器" />
        </DockPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="164"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="instancePages:BedrockServerItem">
                        <Border
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="0">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="RefreshServer_OnClick"
                                        Header="刷新数据"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M500.7,138.7L512,149.4 512,96C512,78.3 526.3,64 544,64 561.7,64 576,78.3 576,96L576,224C576,241.7,561.7,256,544,256L416,256C398.3,256 384,241.7 384,224 384,206.3 398.3,192 416,192L463.9,192 456.3,184.8C456.1,184.6 455.9,184.4 455.7,184.2 380.7,109.2 259.2,109.2 184.2,184.2 109.2,259.2 109.2,380.7 184.2,455.7 259.2,530.7 380.7,530.7 455.7,455.7 463.9,447.5 471.2,438.8 477.6,429.6 487.7,415.1 507.7,411.6 522.2,421.7 536.7,431.8 540.2,451.8 530.1,466.3 521.6,478.5 511.9,490.1 501,501 401,601 238.9,601 139,501 39.1,401 39,239 139,139 238.9,39.1 400.7,39 500.7,138.7z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="CopyAddress_OnClick"
                                        Header="复制地址"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M192,384L88.5,384C63.6,384,48.3,356.9,61.1,335.5L114,247.3C122.7,232.8,138.3,224,155.2,224L250.2,224C326.3,95.1 439.8,88.6 515.7,99.7 528.5,101.6 538.5,111.6 540.3,124.3 551.4,200.2 544.9,313.7 416,389.8L416,484.8C416,501.7,407.2,517.3,392.7,526L304.5,578.9C283.2,591.7,256,576.3,256,551.5L256,448C256,412.7,227.3,384,192,384L191.9,384z M464,224C464,197.5 442.5,176 416,176 389.5,176 368,197.5 368,224 368,250.5 442.5,272 416,272 442.5,272 464,250.5 464,224z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="EditServer_OnClick"
                                        Header="编辑"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M416.9,85.2L372,130.1 509.9,268 554.8,223.1C568.4,209.6 576,191.2 576,172 576,152.8 568.4,134.4 554.8,120.9L519.1,85.2C505.6,71.6 487.2,64 468,64 448.8,64 430.4,71.6 416.9,85.2z M338.1,164L122.9,379.1C120.4,381.6 118.1,384.3 115.9,387.1 112.2,391.9 109.3,397.3 107.4,402.9L76,489.2C65.4,518.4 97.6,550.6 126.8,539.1L213.1,507.7C218.7,505.8 224.1,503 228.9,499.3C231.7,497.1 234.4,494.8 236.9,492.3L262,467.2 462.9,432.6C463.6,432.9 459.2,428.7 476,301.9 338.1,164z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="RemoveServer_OnClick"
                                        Header="删除"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M232.7,69.9C237.1,56.8,249.3,48,263.1,48L377,48C390.8,48,403.7,56.8,407.4,69.9L416,96 512,96C529.7,96,544,110.3,544,128 544,145.7,529.7,160,512,160L128,96C110.3,96,96,110.3,96,128 96,145.7,110.3,160,128,160L224,96 232.7,69.9z M128,208L512,208 512,512C512,547.3,508.7,540,448,576L256,576C220.7,576,192,547.3,192,512L128,208z M216,272C202.7,272,192,282.7,192,296L192,488C192,501.3,202.7,512 216,512 229.3,512,240,501.3,240,488L240,296C240,282.7,229.3,272,216,272z M320,272C306.7,272,296,282.7,296,296L296,488C296,501.3,306.7,512 320,512 333.3,512,344,501.3,344,488L344,296C344,282.7,306.7,272,320,272z M424,272C410.7,272,400,282.7,400,296L400,488C400,501.3,410.7,512 424,512 437.3,512,448,533.3,448,488L448,296C448,282.7,437.3,272,424,272z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                                <DockPanel>
                                    <DockPanel Dock="Top">
                                        <Border
                                            CornerRadius="12"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Top"
                                            Width="56">
                                            <Grid>
                                                <Image
                                                    Height="56"
                                                    IsVisible="{Binding HasIcon}"
                                                    Source="{Binding Icon}"
                                                    Stretch="UniformToFill"
                                                    Width="56" />
                                                <PathIcon
                                                    Data="F1 M480,80C515.3,80 544,108.7 544,144L544,464C544,499.3 515.3,528 480,528L160,528C124.7,528 96,499.3 96,464L96,144C96,108.7,124.7,80,160,80L480,80z M432,340C431.1,333.7 430.9,326.6 430.2,320L128,320 128,464C128,482.6 141.3,496 160,496L480,496C498.7,496 512,482.6 512,464L512,320 433.8,320C433.1,326.6 434.9,333.7 432,340L448,416 384,416C377.3,416 352,416 352,416L352,448C352,466.7 437.9,471.9 448,448L464,398.8C480,326.6 437,256 384,256C290.7,256 288,160 480,80z"
                                                    Height="32"
                                                    IsVisible="{Binding !HasIcon}"
                                                    Width="32" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Margin="0,2,0,0"
                                                MaxLines="1"
                                                Text="{Binding AddressText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <StackPanel
                                                Margin="0,3,0,0"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Ellipse
                                                    Fill="{Binding StatusBrush}"
                                                    Height="8"
                                                    Margin="0,0,0,1"
                                                    VerticalAlignment="Center"
                                                    Width="8" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding StatusBrush}"
                                                    Text="{Binding StatusText}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding PingBrush}"
                                                    IsVisible="{Binding HasPing}"
                                                    Text="{Binding PingText}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    IsVisible="{Binding HasPlayers}"
                                                    Text="{Binding PlayersText}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <Panel DockPanel.Dock="Bottom" Margin="3,8,3,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                IsVisible="{Binding HasVersion}"
                                                Text="{Binding VersionText}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                MaxLines="2"
                                                Text="{Binding DescriptionText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>