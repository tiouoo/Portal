<UserControl
    d:DesignHeight="460"
    d:DesignWidth="680"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.AiAnalysisDialog"
    x:ClassModifier="internal"
    x:DataType="instancePages:AiAnalysisDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        RowDefinitions="Auto,Auto,*,Auto"
        Width="680">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.aianalysisdialog_0}}" />
        <Border
            Background="{DynamicResource PureCardBackground}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Grid.Row="2"
            Margin="0,14,0,0"
            Padding="10">
            <TextBox
                AcceptsReturn="True"
                Background="Transparent"
                FontSize="13"
                IsReadOnly="True"
                Text="{Binding ResultText}"
                TextWrapping="Wrap" />
        </Border>
        <DockPanel
            Grid.Row="3"
            LastChildFill="False"
            Margin="0,14,0,0">
            <TextBlock
                DockPanel.Dock="Left"
                FontSize="12"
                Foreground="{Binding StatusColor}"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
            <Button
                Click="Close_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.aianalysisdialog_1}}"
                DockPanel.Dock="Right" />
            <Button
                Click="Copy_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.aianalysisdialog_2}}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding IsComplete}"
                Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</UserControl>