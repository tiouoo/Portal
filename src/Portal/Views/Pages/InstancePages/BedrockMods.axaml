<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.BedrockMods"
    x:DataType="local:BedrockMods"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:converter="clr-namespace:Portal.Module.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converter:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.mod-card">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.mod-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.mod-card-inner.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                PlaceholderText="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_searchMods}}"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180">
                <TextBox.InnerRightContent>
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="18"
                        FontWeight="Thin"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="&#xe615;" />
                </TextBox.InnerRightContent>
            </TextBox>
            <DropDownButton
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.dashboard_edit}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_select}}">
                            <MenuItem
                                Classes="hide-icon"
                                Click="SelectAll_OnClick"
                                Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_selectAll}}"
                                InputGesture="ctrl+A" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="ClearSelection_OnClick"
                                Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_clearSelection}}"
                                InputGesture="ctrl+shift+A" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="InvertSelection_OnClick"
                                Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_invertSelection}}"
                                InputGesture="ctrl+I" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Classes="hide-icon"
                            Click="OpenFolder_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_openFolder}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="Import_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_importMods}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DropDownButton
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Name="FilterSortButton"
                VerticalAlignment="Top" />
            <DropDownButton
                Content="{Binding SelectedCountText}"
                DockPanel.Dock="Right"
                IsVisible="{Binding HasSelection}"
                Margin="0,0,8,0"
                Opacity="{Binding HasSelection, Converter={StaticResource BoolToOpacityConverter}}">
                <Button.Transitions>
                    <Transitions>
                        <DoubleTransition
                            Duration="0:0:0.2"
                            Easing="SineEaseOut"
                            Property="Opacity" />
                    </Transitions>
                </Button.Transitions>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="EnableSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_enableSelected}}"
                            IsEnabled="{Binding HasConfigurableSelection}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="DisableSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_disableSelected}}"
                            IsEnabled="{Binding HasConfigurableSelection}" />
                        <Separator />
                        <MenuItem
                            Classes="hide-icon"
                            Click="DeleteSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_deleteSelected}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    MaxLines="1"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_title}}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    MaxLines="1"
                    Text="{Binding CountText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </DockPanel>
        </DockPanel>
        <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="{Binding IsLoading}"
            Margin="0,10,10,0"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_loading}}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="{Binding IsEmpty}"
            Margin="0,8,10,0"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_empty}}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="96"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:BedrockModItem">
                        <Border
                            Classes.mod-card="True"
                            Classes.selected="{Binding IsSelected}"
                            CornerRadius="11"
                            Cursor="Hand"
                            PointerPressed="ModCard_OnPointerPressed">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="ShowDetails_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_showDetails}}"
                                        IsVisible="{Binding CanConfigureLoadMode}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe60c;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="EnableMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_enableMod}}"
                                        IsVisible="{Binding CanConfigure}"
                                        IsEnabled="{Binding IsDisabled}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe61f;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="DisableMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_disableMod}}"
                                        IsVisible="{Binding CanConfigure}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe61f;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="OpenModFolder_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_openInFolder}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe628;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="DeleteMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_delete}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe640;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                Classes.mod-card-inner="True"
                                Classes.selected="{Binding IsSelected}"
                                CornerRadius="10"
                                Padding="14">
                                <DockPanel>
                                    <StackPanel
                                        DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Binding LastWriteTimeText}" />
                                        <Border
                                            Background="{DynamicResource SystemAccentColor}"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsPreload}"
                                            Padding="6,1">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="White"
                                                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_preload}}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <Border
                                            Background="#A8643030"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsDisabled}"
                                            Padding="6,1">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="White"
                                                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_disabled}}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            IsVisible="{Binding IsDelayed}"
                                            Text="{Binding DelayText}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{Binding SizeAndNameText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTip.Tip="{Binding FileName}" />
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>
