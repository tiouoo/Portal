<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.BedrockMods"
    x:DataType="local:BedrockMods"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <UserControl.Styles>
        <Style Selector="Border.mod-card">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.mod-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.mod-card-inner.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <Button
                Click="OpenFolder_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_0}}"
                DockPanel.Dock="Right"
                VerticalAlignment="Top" />
            <Button
                Click="Import_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_1}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top" />
            <ComboBox
                DockPanel.Dock="Right"
                ItemsSource="{Binding SortOptions}"
                Margin="0,0,8,0"
                Name="SortComboBox"
                SelectionChanged="SortComboBox_OnSelectionChanged"
                VerticalAlignment="Top"
                Width="108" />
            <ComboBox
                DockPanel.Dock="Right"
                ItemsSource="{Binding FilterOptions}"
                Margin="0,0,8,0"
                Name="FilterComboBox"
                SelectionChanged="FilterComboBox_OnSelectionChanged"
                VerticalAlignment="Top"
                Width="132">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ResourceFilterOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                PlaceholderText="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_2}}"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180" />
            <DropDownButton
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_3}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="SelectAll_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_4}}"
                            InputGesture="ctrl+A" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="ClearSelection_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_5}}"
                            InputGesture="ctrl+shift+A" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="InvertSelection_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_6}}"
                            InputGesture="ctrl+I" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DropDownButton
                Content="{Binding SelectedCountText}"
                DockPanel.Dock="Right"
                IsVisible="{Binding HasSelection}"
                Margin="0,0,8,0">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="EnableSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_7}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="DisableSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_8}}" />
                        <Separator />
                        <MenuItem
                            Classes="hide-icon"
                            Click="DeleteSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_9}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_10}}" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    Text="{Binding CountText}" />
            </DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsLoading}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_11}}" />
            <TextBlock
                DockPanel.Dock="Top"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsEmpty}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_12}}" />
        </DockPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="96"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:BedrockModItem">
                        <Border
                            Classes.mod-card="True"
                            Classes.selected="{Binding IsSelected}"
                            CornerRadius="11"
                            Cursor="Hand"
                            PointerPressed="ModCard_OnPointerPressed">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="ShowDetails_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_13}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M320,576C461.4,576 576,461.4 576,320 576,178.6 461.4,64 320,64 178.6,64 64,178.6 64,320 64,461.4 178.6,576 320,576z M288,224C288,206.3 302.3,192 320,192 337.7,192 352,206.3 352,224 352,241.7 337.7,256 320,256 302.3,256 288,241.7 288,224z M280,288L328,288C341.3,288,352,298.7,352,312L352,400 360,400C373.3,400 384,410.7 384,424 384,437.3 373.3,448 360,448L280,448C266.7,448 256,437.3 256,424 256,410.7 266.7,400 280,400L304,400 304,336 280,336C266.7,336 256,325.3 256,312 256,298.7 266.7,288 280,288z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="EnableMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_14}}"
                                        IsVisible="{Binding IsDisabled}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M431.2,476.5L163.5,208.8C141.1,240.2 128,278.6 128,320 128,426 214,512 320,512 361.5,512 399.9,498.9 431.2,476.5z M476.5,431.2C498.9,399.8 512,361.4 512,320 512,214 426,128 320,128 278.5,128 240.1,141.1 208.8,163.5L476.5,431.2z M64,320C64,178.6 178.6,64 320,64 461.4,64 576,178.6 576,320 576,461.4 461.4,576 320,576 178.6,576 64,461.4 64,320z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="DisableMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_15}}"
                                        IsVisible="{Binding IsEnabled}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M431.2,476.5L163.5,208.8C141.1,240.2 128,278.6 128,320 128,426 214,512 320,512 361.5,512 399.9,498.9 431.2,476.5z M476.5,431.2C498.9,399.8 512,361.4 512,320 512,214 426,128 320,128 278.5,128 240.1,141.1 208.8,163.5L476.5,431.2z M64,320C64,178.6 178.6,64 320,64 461.4,64 576,178.6 576,320 576,461.4 461.4,576 320,576 178.6,576 64,461.4 64,320z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="OpenModFolder_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_16}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M480,96C515.3,96,544,124.7,544,160L544,480C544,515.3,515.3,544,480,544L160,544C124.7,544,96,515.3,96,480L96,160C96,124.7,124.7,96,160,96L480,96z M368,360C368,373.3 378.7,384 392,384 405.3,384 416,373.3 416,360L416,248C416,234.7,405.3,224,392,224L280,224C266.7,224,256,234.7,256,248 256,261.3 266.7,272 280,272L334.1,272 231.1,375C221.7,384.4 221.7,399.6 231.1,408.9 240.5,418.2 255.7,418.3 265,408.9L368,305.9 368,360z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="DeleteMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_17}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M232.7,69.9C237.1,56.8,249.3,48,263.1,48L377,48C390.8,48,403.7,56.8,407.4,69.9L416,96 512,96C529.7,96,544,110.3,544,128 544,145.7 529.7,160 512,160L128,160C110.3,160,96,145.7,96,128 96,110.3,110.3,96,128,96L224,96 232.7,69.9z M128,208L512,208 512,512C512,547.3,483.3,576,448,576L192,576C156.7,576,128,547.3,128,512L128,208z M216,272C202.7,272,192,282.7,192,296L192,488C192,501.3,202.7,512,216,512 229.3,512,240,501.3,240,488L240,296C240,282.7,229.3,272,216,272z M320,272C306.7,272,296,282.7,296,296L296,488C296,501.3,306.7,512,320,512 333.3,512,344,501.3,344,488L344,296C344,282.7,333.3,272,320,272z M424,272C410.7,272,400,282.7,400,296L400,488C400,501.3,410.7,512,424,512 437.3,512,448,501.3,448,488L448,296C448,282.7,437.3,272,424,272z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                Classes.mod-card-inner="True"
                                Classes.selected="{Binding IsSelected}"
                                CornerRadius="10"
                                Padding="14">
                                <DockPanel>
                                    <StackPanel
                                        DockPanel.Dock="Bottom"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Binding LastWriteTimeText}" />
                                        <Border
                                            Background="{DynamicResource SystemAccentColor}"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsPreload}"
                                            Padding="6,1">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="White"
                                                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_18}}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <Border
                                            Background="#A8643030"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsDisabled}"
                                            Padding="6,1">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="White"
                                                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockmods_19}}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            IsVisible="{Binding IsDelayed}"
                                            Text="{Binding DelayText}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{Binding SizeAndNameText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        ToolTip.Tip="{Binding FileName}" />
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>