<UserControl
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.Servers"
    x:DataType="instancePages:Servers"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:controls1="clr-namespace:Portal.Views.Components.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <Button
                Click="AddServer_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_addServer}}"
                DockPanel.Dock="Right"
                VerticalAlignment="Top" />
            <Button
                Click="Refresh_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_refreshAll}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top" />
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    MaxLines="1"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_title}}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    MaxLines="1"
                    Text="{Binding ServerCountText}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    IsVisible="{Binding IsRefreshing}"
                    Margin="0,8,0,0"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_refreshing}}"
                    TextWrapping="NoWrap" />
            </DockPanel>
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsLoading}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_loading}}" />
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsEmpty}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_empty}}" />
        </DockPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding Items}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="164"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="instancePages:ServerItem">
                        <Border
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="0">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="RefreshServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_refreshServer}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M500.7,138.7L512,149.4 512,96C512,78.3 526.3,64 544,64 561.7,64 576,78.3 576,96L576,224C576,241.7,561.7,256,544,256L416,256C398.3,256 384,241.7 384,224 384,206.3 398.3,192 416,192L463.9,192 456.3,184.8C456.1,184.6 455.9,184.4 455.7,184.2 380.7,109.2 259.2,109.2 184.2,184.2 109.2,259.2 109.2,380.7 184.2,455.7 259.2,530.7 380.7,530.7 455.7,455.7 463.9,447.5 471.2,438.8 477.6,429.6 487.7,415.1 507.7,411.6 522.2,421.7 536.7,431.8 540.2,451.8 530.1,466.3 521.6,478.5 511.9,490.1 501,501 401,601 238.9,601 139,501 39.1,401 39,239 139,139 238.9,39.1 400.7,39 500.7,138.7z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="LaunchServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_quickPlay}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M434.8,54.1C446.7,62.7,451.1,78.3,445.7,91.9L367.3,288 512,288C525.5,288 537.5,296.4 542.1,309.1 546.7,321.8 542.8,336 532.5,344.6L244.5,584.6C233.2,594 217.1,594.5 205.2,585.9 193.3,577.3 188.9,561.7 194.3,548.1L272.7,352 128,352C114.5,352 102.5,343.6 97.9,330.9 93.3,318.2 97.2,304 107.5,295.4L395.5,55.4C406.8,46,422.9,45.5,434.8,54.1z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="CopyAddress_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_copyAddress}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M192,384L88.5,384C63.6,384,48.3,356.9,61.1,335.5L114,247.3C122.7,232.8,138.3,224,155.2,224L250.2,224C326.3,95.1 439.8,88.6 515.7,99.7 528.5,101.6 538.5,111.6 540.3,124.3 551.4,200.2 544.9,313.7 416,389.8L416,484.8C416,501.7,407.2,517.3,392.7,526L304.5,578.9C283.2,591.7,256,576.3,256,551.5L256,448C256,412.7,227.3,384,192,384L191.9,384z M464,224C464,197.5 442.5,176 416,176 389.5,176 368,197.5 368,224 368,250.5 389.5,272 416,272 442.5,272 464,250.5 464,224z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="CreateShortcut_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_createShortcut}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M439.4,96L448,96C483.3,96,512,124.7,512,160L512,512C512,547.3,483.3,576,448,576L192,576C156.7,576,128,547.3,128,512L128,160C128,124.7,156.7,96,192,96L200.6,96C211.6,76.9,232.3,64,256,64L384,64C407.7,64,428.4,76.9,439.4,96z M376,176C389.3,176 400,165.3 400,152 400,138.7 389.3,128 376,128L264,128C250.7,128 240,138.7 240,152 240,165.3 250.7,176 264,176L376,176z M256,320C256,302.3 241.7,288 224,288 206.3,288 192,302.3 192,320 192,337.7 206.3,352 224,352 241.7,352 256,337.7 256,320z M288,320C288,333.3,298.7,344,312,344L424,344C437.3,344 448,333.3 448,320 448,306.7 437.3,296 424,296L312,296C298.7,296,288,306.7,288,320z M288,448C288,461.3,298.7,472,312,472L424,472C437.3,472 448,461.3 448,448 448,434.7 437.3,424 424,424L312,424C298.7,424,288,434.7,288,448z M224,480C241.7,480 256,465.7 256,448 256,430.3 241.7,416 224,416 206.3,416 192,430.3 192,448 192,465.7 206.3,480 224,480z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="EditServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_edit}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M416.9,85.2L372,130.1 509.9,268 554.8,223.1C568.4,209.6 576,191.2 576,172 576,152.8 568.4,134.4 554.8,120.9L519.1,85.2C505.6,71.6 487.2,64 468,64 448.8,64 430.4,71.6 416.9,85.2z M338.1,164L122.9,379.1C112.2,389.8,104.4,403.2,100.3,417.8L64.9,545.6C62.6,553.9 64.9,562.9 71.1,569 77.3,575.1 86.2,577.5 94.5,575.2L222.3,539.7C236.9,535.6,250.2,527.9,261,517.1L476,301.9 338.1,164z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="RemoveServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_delete}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M232.7,69.9C237.1,56.8,249.3,48,263.1,48L377,48C390.8,48,403.7,56.8,407.4,69.9L416,96 512,96C529.7,96,544,110.3,544,128 544,145.7 529.7,160 512,160L128,160C110.3,160,96,145.7,96,128 96,110.3,110.3,96,128,96L224,96 232.7,69.9z M128,208L512,208 512,512C512,547.3,483.3,576,448,576L192,576C156.7,576,128,547.3,128,512L128,208z M216,272C202.7,272,192,282.7,192,296L192,488C192,501.3,202.7,512 216,512 229.3,512,240,501.3,240,488L240,296C240,282.7,229.3,272,216,272z M320,272C306.7,272,296,282.7,296,296L296,488C296,501.3,306.7,512 320,512 333.3,512,344,501.3,344,488L344,296C344,282.7,306.7,272,320,272z M424,272C410.7,272,400,282.7,400,296L400,488C400,501.3,410.7,512 424,512 437.3,512,448,501.3,448,488L448,296C448,282.7,437.3,272,424,272z"
                                                Height="16"
                                                Width="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                                <DockPanel>
                                    <DockPanel Dock="Top">
                                        <Border
                                            CornerRadius="12"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Top"
                                            Width="56">
                                            <Grid>
                                                <Image
                                                    Height="56"
                                                    IsVisible="{Binding HasIcon}"
                                                    Source="{Binding Icon}"
                                                    Stretch="UniformToFill"
                                                    Width="56" />
                                                <PathIcon
                                                    Data="F1 M640,640z M0,0z M451.5,160C434.9,160 418.8,164.5 404.7,172.7 388.9,156.7 370.5,143.3 350.2,133.2 378.4,109.2 414.3,96 451.5,96 537.9,96 608,166 608,252.5 608,294 591.5,333.8 562.2,363.1L491.1,434.2C461.8,463.5 422,480 380.5,480 294.1,480 224,410 224,323.5 224,305.8 238.3,291.5 256,291.5 273.7,291.5 288,305.8 288,323.5 288,374.6 329.4,416 380.5,416 405,416 428.5,406.3 445.9,388.9L517,317.8C534.3,300.5 544,277 544,252.5 544,201.4 502.6,160 451.5,160z M259.5,224C235,224 211.5,233.7 194.1,251.1L123,322.2C105.7,339.5 96,363 96,387.5 96,438.6 137.4,480 188.5,480 205.1,480 221.2,475.5 235.3,467.3 251.1,483.3 269.5,496.7 289.8,506.8 261.6,530.8 225.7,544 188.5,544 102.1,544 32,474 32,387.5 32,346 48.5,306.2 77.8,276.9L148.9,205.8C178.2,176.5 218,160 259.5,160 345.9,160 416,230 416,316.5 416,334.2 401.7,348.5 384,348.5 366.3,348.5 352,334.2 352,316.5 352,265.4 310.6,224 259.5,224z"
                                                    Height="32"
                                                    IsVisible="{Binding !HasIcon}"
                                                    Width="32" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Margin="0,2,0,0"
                                                MaxLines="1"
                                                Text="{Binding AddressText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <StackPanel
                                                Margin="0,3,0,0"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Ellipse
                                                    Fill="{Binding StatusBrush}"
                                                    Height="8"
                                                    Margin="0,0,0,1"
                                                    VerticalAlignment="Center"
                                                    Width="8" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding StatusBrush}"
                                                    Text="{Binding StatusText}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding PingBrush}"
                                                    IsVisible="{Binding HasPing}"
                                                    Text="{Binding PingText}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    IsVisible="{Binding HasPlayers}"
                                                    Text="{Binding PlayersText}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <Panel DockPanel.Dock="Bottom" Margin="3,8,3,0">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="LaunchServer_OnClick"
                                            Cursor="Hand"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Padding="4,-2,2,0"
                                            Tag="{Binding}"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_launchServer}}"
                                            VerticalAlignment="Bottom"
                                            VerticalContentAlignment="Bottom">
                                            <PathIcon
                                                Data="F1 M640,640z M0,0z M541.9,139.5C546.4,127.7 543.6,114.3 534.7,105.4 525.8,96.5 512.4,93.6 500.6,98.2L84.6,258.2C71.9,263 63.7,275.2 64,288.7 64.3,302.2 73.1,314.1 85.9,318.3L262.7,377.2 321.6,554C325.9,566.8 337.7,575.6 351.2,575.9 364.7,576.2 376.9,568 381.8,555.4L541.8,139.4z"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Height="15"
                                                Width="15" />
                                        </Button>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                IsVisible="{Binding HasVersion}"
                                                Text="{Binding VersionText}"
                                                VerticalAlignment="Center" />
                                            <controls1:MinecraftTextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                MaxLines="2"
                                                Text="{Binding DescriptionText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="WrapWithOverflow"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>