<UserControl
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.Servers"
    x:DataType="instancePages:Servers"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:controls1="clr-namespace:Portal.Views.Components.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:Portal.Module" xmlns:loc="using:Portal.Localization">
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <Button
                Click="AddServer_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_addServer}}"
                DockPanel.Dock="Right"
                VerticalAlignment="Top" />
            <Button
                Click="Refresh_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_refreshAll}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top" />
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    MaxLines="1"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_title}}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    MaxLines="1"
                    Text="{Binding ServerCountText}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    IsVisible="{Binding IsRefreshing}"
                    Margin="0,8,0,0"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_refreshing}}"
                    TextWrapping="NoWrap" />
            </DockPanel>
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsLoading}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_loading}}" />
            <TextBlock
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsEmpty}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_empty}}" />
        </DockPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding Items}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="164"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="instancePages:ServerItem">
                        <Border
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="0">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="RefreshServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_refreshServer}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph arrow-rotate-right}" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="LaunchServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_quickPlay}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph bolt}" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="CopyAddress_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_copyAddress}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph arrow-up-from-bracket}" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="CreateShortcut_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_createShortcut}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph newspaper}" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="EditServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_edit}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph pen}" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="RemoveServer_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_delete}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph trash-can}" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                                <DockPanel>
                                    <DockPanel Dock="Top">
                                        <Border
                                            CornerRadius="12"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Top"
                                            Width="56">
                                            <Grid>
                                                <Image
                                                    Height="56"
                                                    IsVisible="{Binding HasIcon}"
                                                    Source="{Binding Icon}"
                                                    Stretch="UniformToFill"
                                                    Width="56" />
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph link}" FontSize="32" IsVisible="{Binding !HasIcon}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Margin="0,2,0,0"
                                                MaxLines="1"
                                                Text="{Binding AddressText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <StackPanel
                                                Margin="0,3,0,0"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Ellipse
                                                    Fill="{Binding StatusBrush}"
                                                    Height="8"
                                                    Margin="0,0,0,1"
                                                    VerticalAlignment="Center"
                                                    Width="8" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding StatusBrush}"
                                                    Text="{Binding StatusText}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{Binding PingBrush}"
                                                    IsVisible="{Binding HasPing}"
                                                    Text="{Binding PingText}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    IsVisible="{Binding HasPlayers}"
                                                    Text="{Binding PlayersText}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <Panel DockPanel.Dock="Bottom" Margin="3,8,3,0">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="LaunchServer_OnClick"
                                            Cursor="Hand"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Padding="4,-2,2,0"
                                            Tag="{Binding}"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{Translate {x:Static loc:InstancesLanguageManager+Keys.servers_launchServer}}"
                                            VerticalAlignment="Bottom"
                                            VerticalContentAlignment="Bottom">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{icons:IconGlyph location}" FontSize="15" Foreground="{DynamicResource InnerForegroundColor}" />
                                        </Button>
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                IsVisible="{Binding HasVersion}"
                                                Text="{Binding VersionText}"
                                                VerticalAlignment="Center" />
                                            <controls1:MinecraftTextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                MaxLines="2"
                                                Text="{Binding DescriptionText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="WrapWithOverflow"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>