<UserControl
    x:Class="Portal.Views.Pages.InstancePages.WorldSavePlayers"
    x:DataType="local:WorldSaveDetailsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="8">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_0}}" />
        </StackPanel>
        <controls:ScrollView Grid.Row="1" Margin="0,7,0,0">
            <StackPanel Margin="0,7,0,0" Spacing="12">
                <TextBlock IsVisible="{Binding IsLoading}" Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_1}}" />
                <TextBlock IsVisible="{Binding !HasPlayers}" Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_2}}" />
                <ItemsRepeater ItemsSource="{Binding Players}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:WorldPlayerDataSetting">
                            <Border
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding PlayerId}" />
                                            <TextBlock Foreground="{DynamicResource InnerForegroundColor}" Text="{Binding DataVersionDisplay}" />
                                        </StackPanel>
                                        <Button
                                            Command="{Binding $parent[UserControl].((local:WorldSaveDetailsViewModel)DataContext).SavePlayerCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_3}}"
                                            Grid.Column="1"
                                            IsVisible="{Binding $parent[UserControl].((local:WorldSaveDetailsViewModel)DataContext).IsUnlocked}" />
                                    </Grid>
                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        ColumnSpacing="8"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_4}}" />
                                            <TextBox Text="{Binding GameMode}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_5}}" />
                                            <TextBox Text="{Binding Health}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_6}}" />
                                            <TextBox Text="{Binding FoodLevel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_7}}" />
                                            <TextBox Text="{Binding Saturation}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_8}}" />
                                            <TextBox Text="{Binding ExperienceLevel}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Grid.Row="1"
                                            Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_9}}" />
                                            <TextBox Text="{Binding ExperienceTotal}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_10}}" />
                                            <TextBox Text="{Binding ExperienceProgress}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_11}}" />
                                            <TextBox Text="{Binding Dimension}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_12}}" />
                                            <TextBox Text="{Binding PositionX}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_13}}" />
                                            <TextBox Text="{Binding PositionY}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_14}}" />
                                            <TextBox Text="{Binding PositionZ}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <ToggleSwitch
                                            IsChecked="{Binding Invulnerable}"
                                            OffContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_15}}"
                                            OnContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_16}}" />
                                        <ToggleSwitch
                                            IsChecked="{Binding MayFly}"
                                            OffContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_17}}"
                                            OnContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_18}}" />
                                        <ToggleSwitch
                                            IsChecked="{Binding Flying}"
                                            OffContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_19}}"
                                            OnContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_20}}" />
                                        <ToggleSwitch
                                            IsChecked="{Binding Instabuild}"
                                            OffContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_21}}"
                                            OnContent="{Translate {x:Static loc:InstancesLanguageManager+Keys.worldsaveplayers_22}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </controls:ScrollView>
    </Grid>
</UserControl>