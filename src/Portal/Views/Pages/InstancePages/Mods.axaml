<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.Mods"
    x:DataType="local:Mods"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Portal.Localization"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:owned="clr-namespace:Portal.Views.Components"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Border.mod-card">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.mod-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.mod-card-inner.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <DropDownButton
                Content="{Binding SelectedCountText}"
                DockPanel.Dock="Right"
                IsVisible="{Binding HasMultipleSelection}"
                Margin="0,0,8,0"
                VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="EnableSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_enableSelected}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="DisableSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_disableSelected}}" />
                        <Separator />
                        <MenuItem
                            Classes="hide-icon"
                            Click="DeleteSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_deleteSelected}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Name="SearchBox"
                PlaceholderText="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_searchMods}}"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180" />
            <DropDownButton
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.dashboard_edit}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_select}}">
                            <MenuItem
                                Classes="hide-icon"
                                Click="SelectAll_OnClick"
                                Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_selectAll}}"
                                InputGesture="ctrl+A" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="ClearSelection_OnClick"
                                Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_clearSelection}}"
                                InputGesture="ctrl+shift+A" />
                            <MenuItem
                                Classes="hide-icon"
                                Click="InvertSelection_OnClick"
                                Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_invertSelection}}"
                                InputGesture="ctrl+I" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Classes="hide-icon"
                            Click="OpenFolder_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_openFolder}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="Import_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_importMods}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="CheckUpdates_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_checkUpdates}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DropDownButton
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Name="FilterSortButton"
                VerticalAlignment="Top" />
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    MaxLines="1"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_title}}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    MaxLines="1"
                    Text="{Binding ModCountText}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    IsVisible="{Binding IsLoadingMetadata}"
                    Margin="0,8,0,0"
                    MaxLines="1"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_loadingMetadata}}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </DockPanel>
        </DockPanel>
        <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="{Binding IsLoading}"
            Margin="0,10,10,0"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_loading}}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="{Binding IsEmpty}"
            Margin="0,8,10,0"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_empty}}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="117"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:ModItem">
                        <Border
                            Classes.mod-card="True"
                            Classes.selected="{Binding IsSelected}"
                            CornerRadius="11"
                            Cursor="Hand"
                            Padding="0"
                            PointerPressed="ModCard_OnPointerPressed">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="ShowModDetails_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_showDetails}}"
                                        IsVisible="{Binding HasIdentity}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe60c;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="EnableMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_enableMod}}"
                                        IsVisible="{Binding IsDisabled}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe61f;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="DisableMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_disableMod}}"
                                        IsVisible="{Binding IsEnabled}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe61f;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="UpdateMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_updateMod}}"
                                        IsVisible="{Binding IsUpdatable}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe63c;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="SwitchVersionMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_switchVersion}}"
                                        IsVisible="{Binding HasIdentity}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe621;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="RollbackMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_rollbackUpdate}}"
                                        IsVisible="{Binding HasRollback}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe622;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator IsVisible="{Binding HasIdentity}" />
                                    <MenuItem
                                        Click="OpenModFolder_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_openInFolder}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe628;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="DeleteMod_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_delete}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe640;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition
                                        Duration="0:0:0.16"
                                        Easing="SineEaseOut"
                                        Property="BorderBrush" />
                                </Transitions>
                            </Border.Transitions>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                Classes.mod-card-inner="True"
                                Classes.selected="{Binding IsSelected}"
                                CornerRadius="10"
                                Padding="10">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition
                                            Duration="0:0:0.16"
                                            Easing="SineEaseOut"
                                            Property="BorderBrush" />
                                    </Transitions>
                                </Border.Transitions>
                                <DockPanel>
                                    <DockPanel Dock="Top">
                                        <Border
                                            Background="{DynamicResource TranslucentBorderBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="12"
                                            DockPanel.Dock="Left"
                                            Height="56"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Top"
                                            Width="56">
                                            <Grid>
                                                <Image
                                                    Height="56"
                                                    IsVisible="{Binding HasIcon}"
                                                    Source="{Binding Icon}"
                                                    Stretch="UniformToFill"
                                                    Width="56" />
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="32"
                                                    FontWeight="Thin"
                                                    HorizontalAlignment="Center"
                                                    IsVisible="{Binding !HasIcon}"
                                                    Text="&#xe631;"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                                            <DockPanel ToolTip.Tip="{Binding FileName}">
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource InnerForegroundColor}"
                                                    IsVisible="{Binding IsDisabled}"
                                                    Margin="0,0,5,0"
                                                    MaxLines="1"
                                                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_disabled}}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    IsVisible="{Binding IsDuplicate}"
                                                    Margin="0,0,5,0"
                                                    MaxLines="1"
                                                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_duplicate}}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    IsVisible="{Binding HasUpdate}"
                                                    Margin="0,0,5,0"
                                                    MaxLines="1"
                                                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.mods_updatable}}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{Binding FriendlyName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Margin="0,2,0,0"
                                                MaxLines="1"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Margin="0,1,0,0"
                                                MaxLines="1"
                                                Text="{Binding SizeAndNameText}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="3,5,3,0"
                                        MaxLines="2"
                                        Text="{Binding DescriptionText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow" />
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>