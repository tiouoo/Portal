<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.Saves"
    x:DataType="instancePages:Saves"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:loc="using:Portal.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:owned="clr-namespace:Portal.Views.Components"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Name="SearchBox"
                PlaceholderText="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_searchWorlds}}"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180">
                <TextBox.InnerRightContent>
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="18"
                        FontWeight="Thin"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="&#xe615;" />
                </TextBox.InnerRightContent>
            </TextBox>
            <DropDownButton
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.dashboard_edit}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="OpenFolder_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_openFolder}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="Import_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_importWorlds}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DropDownButton
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Name="FilterSortButton"
                VerticalAlignment="Top" />
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    MaxLines="1"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_title}}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    MaxLines="1"
                    Text="{Binding SaveCountText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </DockPanel>
        </DockPanel>
        <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="{Binding IsLoading}"
            Margin="0,10,10,0"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_loading}}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource InnerForegroundColor}"
            IsVisible="{Binding IsEmpty}"
            Margin="0,8,10,0"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_empty}}"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap" />
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="100"
                        MinItemWidth="284"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="instancePages:SaveItem">
                        <Border
                            Background="{DynamicResource TranslucentBackgroundColor}"
                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Cursor="Hand"
                            Padding="12"
                            PointerPressed="InputElement_OnPointerPressed">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="OpenWorldFolder_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_openFolder}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe628;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="ChangeIcon_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_changeIcon}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe63c;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="ShowInfo_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_showDetails}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe653;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="QuickEnter_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_quickEnter}}"
                                        IsVisible="{Binding CanQuickEnter}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe613;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="CreateShortcut_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_createShortcut}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe607;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="DeleteWorld_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.saves_deleteWorld}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock
                                                FontFamily="{StaticResource IconFont}"
                                                FontSize="18"
                                                FontWeight="Thin"
                                                Text="&#xe640;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <DockPanel>
                                <Border
                                    Background="{DynamicResource TranslucentBorderBrush}"
                                    CornerRadius="12"
                                    DockPanel.Dock="Left"
                                    Height="56"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Top"
                                    Width="56">
                                    <owned:OwnedAdvancedImage
                                        CornerRadius="12"
                                        IsVisible="{Binding HasIcon}"
                                        Loader="{Binding ImageLoader}"
                                        Source="{Binding IconPath}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <DockPanel ToolTip.Tip="{Binding FolderName}">
                                        <TextBlock
                                            DockPanel.Dock="Left"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            FontSize="13"
                                            FontWeight="Normal"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Margin="5,0,0,1"
                                            Text="{Binding FolderNameSuffix}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            VerticalAlignment="Bottom" />
                                    </DockPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="0,1,0,0"
                                        Text="{Binding SizeAndFolderText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="0,2,0,0"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="0,1,0,0"
                                        Text="{Binding LastPlayedText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>