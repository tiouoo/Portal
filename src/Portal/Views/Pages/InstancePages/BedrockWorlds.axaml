<UserControl
    x:Class="Portal.Views.Pages.InstancePages.BedrockWorlds"
    x:DataType="local:BedrockWorlds"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <Button
                Click="OpenFolder_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_openFolder}}"
                DockPanel.Dock="Right"
                VerticalAlignment="Top" />
            <Button
                Click="Import_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_importWorlds}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top" />
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                PlaceholderText="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_searchWorlds}}"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180" />
            <ComboBox
                DisplayMemberBinding="{Binding}"
                DockPanel.Dock="Right"
                ItemsSource="{Binding WorldUserIds}"
                Margin="0,0,8,0"
                MinWidth="180"
                Name="WorldUserIdSelector"
                SelectionChanged="WorldUserIdSelector_OnSelectionChanged"
                ToolTip.Tip="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_selectUserId}}"
                VerticalAlignment="Top" />
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_title}}" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    Text="{Binding CountText}" />
            </DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsLoading}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_loading}}" />
            <TextBlock
                DockPanel.Dock="Top"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsEmpty}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_empty}}" />
        </DockPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="244"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:BedrockWorldItem">
                        <Border
                            Background="{DynamicResource TranslucentBackgroundColor}"
                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="OpenWorldFolder_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_openInFolder}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe628;" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="DeleteWorld_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworlds_deleteWorld}}"
                                        Tag="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe640;" FontSize="16" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel>
                                <Border
                                    Background="{DynamicResource TranslucentBorderBrush}"
                                    ClipToBounds="True"
                                    CornerRadius="7"
                                    Height="120">
                                    <Grid>
                                        <Image
                                            IsVisible="{Binding HasIcon}"
                                            Source="{Binding Icon}"
                                            Stretch="UniformToFill" />
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe64c;" FontSize="32" IsVisible="{Binding !HasIcon}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Margin="3,8,3,0"
                                    MaxLines="1"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding FolderName}" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Margin="3,2,3,0"
                                    MaxLines="1"
                                    Text="{Binding FolderNameText}"
                                    TextTrimming="LeadingCharacterEllipsis" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Margin="3,5,3,0"
                                    Text="{Binding PackSummary}" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource InnerForegroundColor}"
                                    Margin="3,1,3,0"
                                    Text="{Binding ModifiedText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>