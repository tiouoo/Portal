<UserControl
    x:Class="Portal.Views.Pages.InstancePages.BedrockWorldTemplates"
    x:DataType="local:BedrockWorldTemplates"
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:local="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <UserControl.Styles>
        <Style Selector="Border.world-template-card">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.world-template-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.world-template-card-inner.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="10,10,0,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,10,0">
            <Button
                Click="OpenFolder_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_openFolder}}"
                DockPanel.Dock="Right"
                VerticalAlignment="Top" />
            <TextBox
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                PlaceholderText="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_searchWorldTemplates}}"
                TextChanged="SearchBox_OnTextChanged"
                VerticalAlignment="Top"
                Width="180" />
            <DropDownButton
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_select}}"
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Top">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="SelectAll_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_selectAll}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="ClearSelection_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_clearSelection}}" />
                        <MenuItem
                            Classes="hide-icon"
                            Click="InvertSelection_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_invertSelection}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DropDownButton
                Content="{Binding SelectedCountText}"
                DockPanel.Dock="Right"
                IsVisible="{Binding HasMultipleSelection}"
                Margin="0,0,8,0">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Classes="hide-icon"
                            Click="DeleteSelected_OnClick"
                            Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_deleteSelected}}" />
                    </MenuFlyout>
                </Button.Flyout>
            </DropDownButton>
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock
                    Cursor="Hand"
                    FontSize="24"
                    MaxLines="1"
                    PointerPressed="Title_OnPointerPressed"
                    Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_title}}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="10,8,0,0"
                    Text="{Binding CountText}" />
            </DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsLoading}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_loading}}" />
            <TextBlock
                DockPanel.Dock="Top"
                Foreground="{DynamicResource InnerForegroundColor}"
                IsVisible="{Binding IsEmpty}"
                Margin="0,8,0,0"
                Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_empty}}" />
        </DockPanel>
        <controls:ScrollView Classes="Flat" Margin="0,10,0,0">
            <ItemsRepeater ItemsSource="{Binding FilteredItems}" Margin="0,0,10,0">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="16"
                        MinItemHeight="244"
                        MinItemWidth="300"
                        MinRowSpacing="16"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:WorldTemplateItem">
                        <Border
                            Classes.selected="{Binding IsSelected}"
                            Classes.world-template-card="True"
                            CornerRadius="11"
                            Cursor="Hand"
                            PointerPressed="WorldTemplateCard_OnPointerPressed">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Click="ShowWorldTemplateDetails_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_showDetails}}"
                                        Tag="{Binding}" />
                                    <Separator />
                                    <MenuItem
                                        Click="OpenWorldTemplateFolder_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_openInFolder}}"
                                        Tag="{Binding}" />
                                    <MenuItem
                                        Click="DeleteWorldTemplate_OnClick"
                                        Header="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_delete}}"
                                        Tag="{Binding}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                Classes.selected="{Binding IsSelected}"
                                Classes.world-template-card-inner="True"
                                CornerRadius="10"
                                Padding="10">
                                <StackPanel>
                                    <Border
                                        Background="{DynamicResource TranslucentBorderBrush}"
                                        ClipToBounds="True"
                                        CornerRadius="7"
                                        Height="120">
                                        <Grid>
                                            <Image
                                                IsVisible="{Binding HasIcon}"
                                                Source="{Binding Icon}"
                                                Stretch="UniformToFill" />
                                            <TextBlock FontFamily="{StaticResource IconFont}" FontWeight="Thin" Text="&#xe611;" FontSize="32" IsVisible="{Binding !HasIcon}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Margin="3,8,3,0"
                                        MaxLines="1"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding FileName}" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="3,2,3,0"
                                        MaxLines="1"
                                        Text="{Binding PackSummary}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="3,1,3,0">
                                        <Run Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.bedrockworldtemplates_baseGameVersionLabel}}" /><Run Text="{Binding BaseGameVersionText}" />
                                    </TextBlock>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource InnerForegroundColor}"
                                        Margin="3,5,3,0"
                                        MaxLines="2"
                                        Text="{Binding DescriptionText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>