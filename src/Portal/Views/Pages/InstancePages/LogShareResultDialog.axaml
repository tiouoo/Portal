<UserControl
    d:DesignHeight="460"
    d:DesignWidth="560"
    mc:Ignorable="d"
    x:Class="Portal.Views.Pages.InstancePages.LogShareResultDialog"
    x:ClassModifier="internal"
    x:DataType="instancePages:LogShareResultDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:instancePages="clr-namespace:Portal.Views.Pages.InstancePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Portal.Localization">
    <Grid
        Margin="24"
        MaxHeight="560"
        RowDefinitions="Auto,Auto,*,Auto"
        Width="560">
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.logshareresultdialog_title}}" />
        <ScrollViewer
            Grid.Row="2"
            Margin="0,14,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="instancePages:LogShareResultItemViewModel">
                        <Border
                            BorderBrush="{DynamicResource TranslucentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10">
                            <StackPanel Spacing="5">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Left"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Platform}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{Binding StatusColor}"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,-2,0"
                                        Text="{Binding StatusText}" />
                                </DockPanel>
                                <SelectableTextBlock
                                    FontSize="13"
                                    IsVisible="{Binding HasUrl}"
                                    Text="{Binding Url}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{Binding StatusColor}"
                                    IsVisible="{Binding HasError}"
                                    Text="{Binding Error}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    IsVisible="{Binding HasUrl}"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Background="Transparent"
                                        Click="Copy_OnClick"
                                        Tag="{Binding}"
                                        Theme="{StaticResource TransparentButton}">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.logshareresultdialog_copyLink}}" />
                                    </Button>
                                    <Button
                                        Background="Transparent"
                                        Click="Open_OnClick"
                                        Tag="{Binding}"
                                        Theme="{StaticResource TransparentButton}">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            Text="{Translate {x:Static loc:InstancesLanguageManager+Keys.logshareresultdialog_openLink}}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel
            Grid.Row="3"
            LastChildFill="False"
            Margin="0,14,0,0">
            <Button
                Click="Close_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.logshareresultdialog_close}}"
                DockPanel.Dock="Right" />
            <Button
                Click="CopyAll_OnClick"
                Content="{Translate {x:Static loc:InstancesLanguageManager+Keys.logshareresultdialog_copyAllLinks}}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding HasAnyUrl}"
                Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</UserControl>