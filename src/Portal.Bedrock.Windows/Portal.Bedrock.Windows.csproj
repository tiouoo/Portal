<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RootNamespace>Portal.Bedrock</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <NativeInjectorResource>$(MSBuildThisFileDirectory)..\Portal.Bedrock.Uwp.Injector\Inject.dll</NativeInjectorResource>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BedrockLauncher.Core" />
      <PackageReference Include="XUserLauncher.Core" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Portal.Bedrock.Standard\Portal.Bedrock.Standard.csproj" />
      <ProjectReference Include="..\Portal.Bedrock.PeNet\src\PeNet\Portal.Bedrock.PeNet.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="..\Portal.Bedrock.Preload\PreloadCpp.dll"
                        LogicalName="PreloadCpp.dll" />
      <EmbeddedResource Include="$(NativeInjectorResource)"
                        LogicalName="Inject.dll" />
    </ItemGroup>

</Project>
