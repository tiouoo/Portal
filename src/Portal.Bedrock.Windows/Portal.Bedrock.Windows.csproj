<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RootNamespace>Portal.Bedrock</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <NativeInjectorProject>$(MSBuildThisFileDirectory)..\Portal.Bedrock.Uwp.Injector\Uwp.Injector\Uwp.Injector.vcxproj</NativeInjectorProject>
        <NativeInjectorOutput>$(MSBuildThisFileDirectory)..\Portal.Bedrock.Uwp.Injector\Uwp.Injector\bin\x64\Release\Inject.dll</NativeInjectorOutput>
        <NativeInjectorResource>$(MSBuildThisFileDirectory)Inject.dll</NativeInjectorResource>
        <BuildNativeInjector Condition="'$(BuildNativeInjector)' == '' and '$(MSBuildRuntimeType)' == 'Full'">true</BuildNativeInjector>
        <BuildNativeInjector Condition="'$(BuildNativeInjector)' == ''">false</BuildNativeInjector>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BedrockLauncher.Core" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Portal.Bedrock.Standard\Portal.Bedrock.Standard.csproj" />
      <ProjectReference Include="..\Portal.Bedrock.PeNet\src\PeNet\Portal.Bedrock.PeNet.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="..\Portal.Bedrock.Preload\PreloadCpp.dll"
                        LogicalName="PreloadCpp.dll" />
      <EmbeddedResource Include="$(NativeInjectorResource)"
                        LogicalName="Inject.dll" />
    </ItemGroup>

    <Target Name="BuildPortalNativeInjector"
            BeforeTargets="PrepareResources"
            Condition="'$(BuildNativeInjector)' == 'true'">
      <MSBuild Projects="$(NativeInjectorProject)"
               Targets="Build"
               Properties="Configuration=Release;Platform=x64" />
      <Copy SourceFiles="$(NativeInjectorOutput)"
            DestinationFiles="$(NativeInjectorResource)"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
