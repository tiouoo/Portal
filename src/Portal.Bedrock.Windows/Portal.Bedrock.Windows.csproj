<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RootNamespace>Portal.Bedrock</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <NativeInjectorResource>$(MSBuildThisFileDirectory)..\Portal.Bedrock.Injector\Portal.Inject.Cpp.dll</NativeInjectorResource>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Portal.Bedrock.Core\Portal.Bedrock.Core.csproj" />
      <ProjectReference Include="..\Portal.Bedrock.Core.Windows\Portal.Bedrock.Core.Windows.csproj" />
      <ProjectReference Include="..\Portal.Bedrock.Xbox\Portal.Bedrock.Xbox.csproj" />
      <ProjectReference Include="..\Portal.Bedrock.Standard\Portal.Bedrock.Standard.csproj" />
      <ProjectReference Include="..\Portal.Bedrock.PeNet\src\PeNet\Portal.Bedrock.PeNet.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="..\Portal.Bedrock.Preload\Portal.Preload.Net.dll"
                        LogicalName="Portal.Preload.Net.dll" />
      <EmbeddedResource Include="..\Portal.Bedrock.Hook\XUserHook.dll"
                        LogicalName="Portal.Bedrock.XUserHook.dll" />
      <EmbeddedResource Include="$(NativeInjectorResource)"
                        LogicalName="Portal.Inject.Cpp.dll" />
    </ItemGroup>

</Project>
